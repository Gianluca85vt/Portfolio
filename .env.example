# Copy to .env for local development, and add the same ones in Vercel under
# Settings -> Environment Variables. The Supabase values come from the dashboard
# of the portfolio-comments project, under Project Settings -> API.

# Safe to expose: it ends up in the page. Row level security is what protects
# the data, and it only ever returns approved comments.
PUBLIC_SUPABASE_URL=https://zqtojgkbuzfzdvdwoajh.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_0SAIejKjdmdZRRZTVoh0Qg_1KeTuGsQ

# Secret. Bypasses row level security entirely, so it must never reach the
# browser — it is read only inside src/pages/api/comments.ts, which runs on the
# server. Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Salts the hash of the submitter's address used for
# rate limiting, so the hashes cannot be reversed or precomputed.
COMMENT_IP_SALT=

# --- Comment notifications ------------------------------------------------
# Mail for every new comment, sent through your own mailbox over plain SMTP.
# No email service in the middle. Leave these empty and notifications simply do
# not happen — commenting keeps working either way.
#
# Aruba, with a mailbox on the domain:
#   SMTP_HOST=smtps.aruba.it     SMTP_PORT=465
#   SMTP_USER=you@gianlucascattarella.it   SMTP_PASS=<that mailbox's password>
#
# Gmail — needs 2-step verification on, then an App Password (16 characters)
# generated at myaccount.google.com/apppasswords. Your normal Google password
# will not work here:
#   SMTP_HOST=smtp.gmail.com     SMTP_PORT=465
#   SMTP_USER=you@gmail.com      SMTP_PASS=<the app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Where the notifications land, and who they come from. NOTIFY_FROM is optional
# and falls back to SMTP_USER — most providers reject a From they do not own.
NOTIFY_TO=
NOTIFY_FROM=

# Signs the approve/delete links in those emails so nobody can forge one and
# publish their own comment. Any long random string, different from the salt.
COMMENT_ADMIN_SECRET=
