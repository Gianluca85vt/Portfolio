---
import CommentThread from './ui/CommentThread';
import { comments } from '../data/portfolio';

export interface Props {
  /** the post slug — the thread key, stable across domain or URL changes */
  postSlug: string;
}

const { postSlug } = Astro.props;
const configured = Boolean(import.meta.env.PUBLIC_SUPABASE_URL);
---

{comments.enabled && configured ? <CommentThread postSlug={postSlug} client:visible /> : null}
