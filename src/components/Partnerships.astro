---
import { blog } from '../data/portfolio';

// The pitch a brand or a tool vendor reads before deciding whether to get in
// touch. It deliberately does not quote an audience number: the honest one is
// small right now, and a made-up one is the kind of thing that ends a
// relationship the first time somebody asks for analytics access.
const offers = [
  {
    title: 'Review units and hands-on',
    body: 'Hardware, software licences and early builds. GPUs, workstations, displays, capture and scanning kit, DCC and render tooling. I cover what I can put through real production work rather than a spec sheet.',
  },
  {
    title: 'Tool and pipeline coverage',
    body: 'If you build something artists use — a renderer, a plugin, an asset pipeline, a scanning workflow — I am interested in what it changes about the job, not the feature list. That tends to make a more useful piece than a launch post.',
  },
  {
    title: 'Sponsorship and placement',
    body: 'Section sponsorship and banner placement on the blog. I will tell you which pieces perform and which do not, because the alternative is you finding out on your own and not coming back.',
  },
];

const rules = [
  'Anything gifted, loaned or paid for is disclosed in the piece itself.',
  'Sponsored and affiliate links carry rel="sponsored". I do not sell link insertions into existing articles, and I do not publish guest posts written to place a link — that is against Google’s policies and it would damage the site faster than it would pay for itself.',
  'Editorial control stays with me. You get the coverage, not the verdict, and I will say so up front if the answer is going to be unflattering.',
  'Review units get returned or disclosed as kept, whichever you prefer.',
];
---

<section id="partnerships" class="px-5 sm:px-8 md:px-10 pb-24 scroll-mt-24">
  <div class="max-w-[1180px] mx-auto">
    <!-- A <details> rather than a scripted panel: it opens with no JavaScript,
         it is keyboard operable for free, and a reader who arrives on the
         #partnerships anchor gets it already open. The pitch is for the few
         people looking for it, so it should not sit at the foot of every
         visit. -->
    <details
      class="group rounded-[20px] border overflow-hidden"
      style="border-color:rgba(215,226,234,0.14);background:linear-gradient(155deg,rgba(24,1,31,0.55),rgba(118,33,176,0.10))"
    >
      <summary
        class="cursor-pointer list-none select-none px-7 sm:px-10 py-6 flex items-center justify-between gap-5 transition-colors hover:bg-[#D7E2EA]/[0.04]"
      >
        <span class="min-w-0">
          <span class="block text-[#D7E2EA]/40 font-medium uppercase tracking-[0.2em] text-[0.62rem]">
            Advertising / Partnerships
          </span>
          <span
            class="hero-heading block font-black uppercase leading-none tracking-tight mt-2"
            style="font-size:clamp(1.15rem, 2.6vw, 1.7rem)"
          >
            Work with the blog
          </span>
        </span>

        <span
          class="shrink-0 inline-flex items-center gap-2 rounded-full border-2 border-[#D7E2EA]/35 text-[#D7E2EA] font-medium uppercase tracking-widest px-5 py-2.5 text-[0.66rem]"
        >
          <span class="group-open:hidden">Details</span>
          <span class="hidden group-open:inline">Close</span>
          <svg class="w-3.5 h-3.5 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </span>
      </summary>

      <div class="px-7 sm:px-10 pb-8 sm:pb-10 pt-1">

      <p class="text-[#D7E2EA]/60 font-light leading-relaxed mt-5 max-w-[62ch] text-[0.95rem]">
        This is a working 3D environment and technical artist writing for other
        people who make things — environment and technical artists, indie and
        mid-size studio teams, virtual production crews, and the hardware-curious
        end of the games audience. Coverage runs across games, real-time
        graphics, hardware, AI tooling, film and TV production, and manga, with
        the same question underneath all of it: what did this cost to build?
      </p>

      <div class="grid gap-4 sm:grid-cols-3 mt-9">
        {
          offers.map((o) => (
            <div class="rounded-[14px] border border-[#D7E2EA]/12 p-5">
              <h3 class="text-[#D7E2EA] font-medium text-[0.92rem] leading-snug">{o.title}</h3>
              <p class="text-[#D7E2EA]/45 font-light text-[0.82rem] leading-relaxed mt-2.5">
                {o.body}
              </p>
            </div>
          ))
        }
      </div>

      <div class="mt-9 pt-7 border-t border-[#D7E2EA]/10">
        <p class="text-[#D7E2EA]/40 font-medium uppercase tracking-[0.16em] text-[0.6rem]">
          How I handle it
        </p>
        <ul class="mt-4 space-y-2.5">
          {
            rules.map((r) => (
              <li class="text-[#D7E2EA]/50 font-light text-[0.84rem] leading-relaxed pl-4 relative">
                <span class="absolute left-0 top-[0.55em] w-1.5 h-1.5 rounded-full bg-[#B600A8]" />
                <Fragment set:html={r} />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-wrap items-center gap-3 mt-9">
        <a
          href={`mailto:${blog.email}?subject=Partnership%20enquiry`}
          class="inline-flex items-center rounded-full px-7 py-3.5 font-medium uppercase tracking-widest text-[0.7rem] text-white transition-opacity hover:opacity-90"
          style="background:linear-gradient(123deg,#18011F 7%,#B600A8 37%,#7621B0 72%,#BE4C00 100%)"
        >
          Get in touch
        </a>
        <a
          href="/about/"
          class="inline-flex items-center rounded-full border-2 border-[#D7E2EA]/35 text-[#D7E2EA] font-medium uppercase tracking-widest px-7 py-3.5 text-[0.7rem] transition-colors hover:bg-[#D7E2EA]/10"
        >
          Who writes this
        </a>
        <p class="text-[#D7E2EA]/30 font-light text-[0.76rem]">
          Traffic and audience figures on request.
        </p>
      </div>
      </div>
    </details>
  </div>
</section>

<style>
  /* Safari still paints its own disclosure triangle without this. */
  summary::-webkit-details-marker { display: none; }
</style>
