---
import { categoryColors, categoryPath, site } from '../data/portfolio';
import type { BlogCategory } from '../data/portfolio';

export interface Props {
  category: string;
  published: string;
  readingMinutes: number;
  isReview?: boolean;
}

const { category, published, readingMinutes, isReview = false } = Astro.props;

const accent = categoryColors[category as BlogCategory] ?? '#7621B0';
const kind = isReview ? 'Review' : 'Article';

// The avatar is drawn from initials rather than a photograph. public/img/me/ is
// deliberately not committed, so anything pointing at it would render as a
// broken image everywhere except this machine.
const initials = site.name
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
  {/* A link, not a label. Sessions were running 51 seconds and 1.16 pages, and
      the only route deeper into the archive sat past the end of the article —
      no use to a reader who leaves before the halfway mark. This is the one
      exit that is on screen from the first second. */}
  <a
    href={categoryPath(category)}
    class="inline-block rounded-[4px] font-medium uppercase tracking-widest text-white text-[0.62rem] px-2.5 py-1 transition-opacity hover:opacity-80"
    style={`background-color:${accent}`}
  >
    {category}
  </a>
  <span class="text-[#D7E2EA]/35 font-light text-[0.72rem] tracking-wide">
    {published} · {readingMinutes} min
  </span>
</div>

<div class="flex items-center gap-3 mt-6 pt-5 border-t border-[#D7E2EA]/12">
  <span
    class="flex items-center justify-center shrink-0 w-10 h-10 rounded-full text-white font-medium text-[0.72rem] tracking-wide"
    style="background:linear-gradient(140deg,#18011F 10%,#B600A8 90%,#7621B0 150%)"
    aria-hidden="true"
  >
    {initials}
  </span>

  <div class="min-w-0">
    <p class="text-[0.8rem] leading-tight">
      <span class="text-[#D7E2EA]/40 font-light uppercase tracking-widest text-[0.62rem]">
        {kind} by
      </span>{' '}
      <a href="/about/" class="text-[#D7E2EA] font-medium hover:text-white transition-colors">
        {site.name}
      </a>
    </p>
    <p class="text-[#D7E2EA]/35 font-light text-[0.68rem] leading-tight mt-1">
      {site.role}
    </p>
  </div>
</div>
