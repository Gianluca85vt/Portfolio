---
import { nav, site } from '../data/portfolio';

export interface Props {
  current: '/members' | '/blog';
}

const { current } = Astro.props;
const routed = nav.filter((item) => 'to' in item) as { label: string; to: string }[];
---

<header
  class="relative z-20 flex items-center justify-between gap-4 px-5 sm:px-8 md:px-10 pt-6 md:pt-8"
>
  <a
    href="/"
    class="flex items-center gap-2 text-[#D7E2EA] font-medium uppercase tracking-wider text-[0.7rem] sm:text-sm transition-opacity duration-200 hover:opacity-70"
  >
    <svg
      class="w-4 h-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M19 12H5" />
      <path d="m12 19-7-7 7-7" />
    </svg>
    <span class="hidden sm:inline">{site.name}</span>
    <span class="sm:hidden">Home</span>
  </a>

  <nav class="flex items-center gap-x-4 sm:gap-x-6">
    {
      routed.map((item) => (
        <a
          href={item.to}
          aria-current={item.to === current ? 'page' : undefined}
          class:list={[
            'font-medium uppercase tracking-wider text-[0.7rem] sm:text-sm transition-opacity duration-200 hover:opacity-70',
            item.to === current ? 'text-white' : 'text-[#D7E2EA]/60',
          ]}
        >
          {item.label}
        </a>
      ))
    }
    <a
      href="/#contact"
      class="text-[#D7E2EA]/60 font-medium uppercase tracking-wider text-[0.7rem] sm:text-sm transition-opacity duration-200 hover:opacity-70"
    >
      Contact
    </a>
  </nav>
</header>
