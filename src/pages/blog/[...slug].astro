---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Comments from '../../components/Comments.astro';
import ShareBar from '../../components/ui/ShareBar';
import ScoreBox from '../../components/ScoreBox.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { site, blog, categoryPath, coverFor } from '../../data/portfolio';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
// Rendered by Astro at build time: the article ships as real HTML, readable by
// crawlers and by anyone with JavaScript off.
const { Content } = await render(entry);

const readingMinutes = Math.max(
  1,
  Math.round((entry.body ?? '').trim().split(/\s+/).length / 200)
);
const published = entry.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const url = new URL(`/blog/${entry.id}/`, Astro.site).href;
const cover = coverFor(entry.data.category, entry.data.cover);

// BlogPosting tells Google this is an article, who wrote it and when — the
// difference between a page that can rank and one eligible for rich results.
// A scored piece is also a Review in schema.org terms, and saying so is what
// makes the number eligible to show in a search result rather than being
// invisible markup.
const scored = entry.data.score !== undefined;
const rounded = scored ? Math.round(entry.data.score! * 2) / 2 : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': scored ? ['BlogPosting', 'Review'] : 'BlogPosting',
  ...(scored
    ? {
        itemReviewed: { '@type': 'Thing', name: entry.data.reviewOf ?? entry.data.title },
        reviewRating: {
          '@type': 'Rating',
          ratingValue: rounded,
          bestRating: 10,
          worstRating: 1,
        },
      }
    : {}),
  headline: entry.data.title,
  description: entry.data.excerpt ?? entry.data.title,
  datePublished: entry.data.date.toISOString(),
  dateModified: entry.data.date.toISOString(),
  articleSection: entry.data.category,
  wordCount: (entry.body ?? '').trim().split(/\s+/).length,
  inLanguage: 'en',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
  ...(cover ? { image: new URL(cover, Astro.site).href } : {}),
  // One named author across the whole blog, with the credentials attached and
  // pointing at a real about page. Search engines weigh author identity, and a
  // named specialist with a body of work behind them is the thing to weigh.
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
    jobTitle: site.role,
  },
  creativeWorkStatus: 'Published',
  // Where this page sits. Google renders the trail in place of the raw URL in a
  // result, and it is also how a crawler learns the archive has sections rather
  // than 109 articles hanging off one index.
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: blog.name, item: new URL('/blog/', site.url).href },
      {
        '@type': 'ListItem',
        position: 2,
        name: entry.data.category,
        item: new URL(categoryPath(entry.data.category), site.url).href,
      },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: url },
    ],
  },
  // The masthead publishes; the person writes. Keeping these separate is what
  // lets the blog carry its own name without detaching the articles from him.
  publisher: {
    '@type': 'Organization',
    name: blog.name,
    url: new URL('/blog/', site.url).href,
  },
};
---

<!-- The title carries no masthead suffix. Google shows the site name beside
     the result on its own now, so appending it repeated the same words while
     eating eleven of the sixty characters a result actually displays. -->
<Base
  title={entry.data.title}
  description={entry.data.excerpt ?? entry.data.title}
  image={cover}
  type="article"
  publishedAt={entry.data.date.toISOString()}
  jsonLd={jsonLd}
>
  <div class="min-h-screen flex flex-col" style="overflow-x:clip">
    <SiteHeader current="/blog" />

    <article class="px-5 sm:px-8 md:px-10 pt-12 sm:pt-16 pb-20 sm:pb-24">
      <div class="max-w-[720px] mx-auto">
        <nav aria-label="Breadcrumb" class="text-[0.7rem] tracking-wide mb-7">
          <ol class="flex flex-wrap items-center gap-2 text-[#D7E2EA]/40 font-light">
            <li><a href="/blog/" class="hover:text-[#D7E2EA] transition-colors">Backdrop</a></li>
            <li aria-hidden="true">/</li>
            <li>
              <a
                href={categoryPath(entry.data.category)}
                class="hover:text-[#D7E2EA] transition-colors"
              >
                {entry.data.category}
              </a>
            </li>
          </ol>
        </nav>

        {
          entry.data.column && (
            <p
              class="font-medium uppercase tracking-[0.2em] text-[0.68rem] mt-1"
              style="color:#B600A8"
            >
              {entry.data.column}
            </p>
          )
        }

        <h1
          class="hero-heading font-black uppercase leading-[1.05] tracking-tight mt-5"
          style="font-size:clamp(2rem, 6vw, 3.75rem)"
        >
          {entry.data.title}
        </h1>

        <ArticleByline
          category={entry.data.category}
          published={published}
          readingMinutes={readingMinutes}
          isReview={scored}
        />

        {
          /* Described rather than hidden. This was aria-hidden with an empty
             alt, which is right for pure decoration and wrong here: it is a
             press still or a screenshot of the thing the piece is about, and an
             image with no alt is one Google Images cannot place against any
             query. Eager, because it is the largest paint on every article. */
          cover && (
            <img
              src={cover}
              alt={`${entry.data.reviewOf ?? entry.data.title} — ${entry.data.category} on Backdrop`}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full rounded-[24px] sm:rounded-[28px] object-cover mt-8 sm:mt-10"
            />
          )
        }

        <div class="post-body mt-10 sm:mt-12">
          <Content />
        </div>

        {
          entry.data.score !== undefined && (
            <ScoreBox
              score={entry.data.score}
              category={entry.data.category}
              reviewOf={entry.data.reviewOf}
              sources={entry.data.scoreSources}
            />
          )
        }

        <RelatedPosts slug={entry.id} category={entry.data.category} />

        <div class="mt-14 sm:mt-16">
          <ShareBar
            url={url}
            title={entry.data.title}
            excerpt={entry.data.excerpt ?? ''}
            client:visible
          />
        </div>

        <Comments postSlug={entry.id} />

        <script is:inline>
          // Swap the still for the real player on click. Nothing is requested
          // from Google until someone asks for the video, so an article that is
          // read and never watched costs its readers nothing.
          //
          // `data-external` opts a block out of this. An age-restricted video
          // refuses to play in any embed — YouTube requires a signed-in viewer
          // on its own site — so those are marked up as links instead, and the
          // handler must leave them alone rather than replacing a working link
          // with a player that will only ever show an error.
          document.querySelectorAll('.video-embed:not([data-external])').forEach((el) => {
            el.addEventListener('click', () => {
              const id = el.dataset.video;
              if (!id || el.dataset.loaded) return;
              el.dataset.loaded = '1';

              const frame = document.createElement('iframe');
              // nocookie is the privacy-preserving host; autoplay because the
              // click was the request to watch.
              frame.src =
                'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
              frame.title = el.dataset.title || 'Video';
              frame.allow =
                'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
              frame.allowFullscreen = true;
              el.replaceChildren(frame);
            });
          });
        </script>

        <a
          href="/blog/"
          class="inline-flex items-center gap-2 rounded-full border-2 border-[#D7E2EA]/50 text-[#D7E2EA] font-medium uppercase tracking-widest px-7 py-3 text-xs sm:text-sm transition-colors duration-300 hover:bg-[#D7E2EA]/10 mt-14 sm:mt-16"
        >
          <svg
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 12H5" />
            <path d="m12 19-7-7 7-7" />
          </svg>
          All articles
        </a>
      </div>
    </article>
  </div>
</Base>
