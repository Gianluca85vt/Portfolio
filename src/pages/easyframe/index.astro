.limits .limit:nth-child(2){transition-delay:.06s}
.limits .limit:nth-child(3){transition-delay:.12s}
.limits .limit:nth-child(4){transition-delay:.18s}
.limits .limit:nth-child(5){transition-delay:.24s}
.limits .limit:nth-child(6){transition-delay:.30s}
.limit{
  border-left:2px solid rgba(251,191,36,.5); border-radius:0 14px 14px 0;
