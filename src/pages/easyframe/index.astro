<style is:global>
:root{
  --bg:#0B0B12; --bg2:#101019; --surface:#15151F; --surface2:#1C1C29;
  --border:#2A2A3C; --border-soft:#1F1F2E;
  --text:#F1F1F6; --dim:#9B9BB2; --faint:#666680;
  --accent:#7C5CFF; --accent-hi:#9B84FF; --cyan:#22D3EE;
  --ok:#34D399; --warn:#FBBF24; --danger:#F87171;
  --grad:linear-gradient(135deg,#7C5CFF 0%,#8B6BFF 40%,#22D3EE 100%);
  --wrap:1180px;
  --mono:"JetBrains Mono",ui-monospace,"Cascadia Code",Consolas,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0; background:var(--bg); color:var(--text);
  font-family:Inter,"Segoe UI Variable Text","Segoe UI",system-ui,-apple-system,sans-serif;
  font-size:16px; line-height:1.6; -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
img{max-width:100%; display:block}
a{color:inherit; text-decoration:none}
h1,h2,h3{margin:0; letter-spacing:-.025em; line-height:1.08; font-weight:800}
p{margin:0}
.wrap{max-width:var(--wrap); margin:0 auto; padding:0 24px; position:relative; z-index:2}

/* ---------------------------------------------------------------- ritmo */
section{padding:clamp(76px,9vw,142px) 0; position:relative}
.rule{height:1px;background:linear-gradient(90deg,transparent,var(--border-soft) 18%,var(--border-soft) 82%,transparent)}
.eyebrow{
  font-size:11.5px; font-weight:700; letter-spacing:.18em; text-transform:uppercase;
  color:var(--accent-hi); margin-bottom:18px; display:flex; align-items:center; gap:10px;
}
.eyebrow::before{content:""; width:22px; height:1px; background:var(--accent); opacity:.7}
h2{font-size:clamp(30px,4.3vw,52px)}
h3{font-size:19px; font-weight:700; letter-spacing:-.01em}
.lede{color:var(--dim); font-size:clamp(16px,1.5vw,18.5px); max-width:660px; margin-top:20px}
.mono{font-family:var(--mono); font-variant-numeric:tabular-nums}

/* --------------------------------------------------------------- bottoni */
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:10px;
  height:52px; padding:0 26px; border-radius:999px; font-weight:700; font-size:15px;
  border:1px solid transparent; cursor:pointer; white-space:nowrap;
  transition:transform .18s cubic-bezier(.2,.7,.3,1), box-shadow .25s, background .25s, border-color .25s;
}
.btn-primary{
  background:var(--grad); color:#0A0A10;
  box-shadow:0 10px 34px -12px rgba(124,92,255,.85), inset 0 1px 0 rgba(255,255,255,.35);
}
.btn-primary:hover{transform:translateY(-2px); box-shadow:0 18px 48px -14px rgba(124,92,255,1)}
.btn-ghost{background:rgba(255,255,255,.03); border-color:var(--border); color:var(--text)}
.btn-ghost:hover{background:rgba(255,255,255,.07); border-color:#3E3E5C; transform:translateY(-2px)}
.btn-sm{height:42px; padding:0 20px; font-size:14px}
.strike{text-decoration:line-through; opacity:.5; font-weight:600}

/* ------------------------------------------------------------------- nav */
.nav{
  position:fixed; top:14px; left:50%; transform:translateX(-50%); z-index:60;
  display:flex; align-items:center; gap:8px;
  padding:8px 8px 8px 16px; border-radius:999px;
  background:rgba(16,16,25,.72); border:1px solid var(--border-soft);
  backdrop-filter:blur(16px) saturate(140%); -webkit-backdrop-filter:blur(16px) saturate(140%);
  box-shadow:0 12px 40px -18px rgba(0,0,0,.9);
  transition:border-color .3s, background .3s;
  max-width:calc(100vw - 28px);
}
.nav.scrolled{border-color:var(--border); background:rgba(16,16,25,.92)}
.brand{display:flex; align-items:center; gap:9px; font-weight:800; letter-spacing:-.02em; padding-right:6px}
.mark{
  width:26px; height:26px; border-radius:8px; background:var(--grad);
  box-shadow:0 0 0 1px rgba(255,255,255,.14), 0 6px 18px -8px rgba(124,92,255,.9);
  position:relative; flex:none;
}
.mark::after{content:""; position:absolute; inset:7px; border:1.6px solid rgba(10,10,16,.85); border-radius:3px}
.nav-links{display:flex; gap:2px; margin:0 4px}
.nav-links a{
  padding:9px 13px; border-radius:999px; font-size:13.5px; color:var(--dim); font-weight:500;
  transition:color .2s, background .2s;
}
.nav-links a:hover{color:var(--text); background:rgba(255,255,255,.05)}
.lang{
  padding:8px 11px; border-radius:999px; font-size:12px; font-weight:700; letter-spacing:.08em;
  color:var(--dim); border:1px solid var(--border-soft); transition:color .2s, border-color .2s;
}
.lang:hover{color:var(--text); border-color:var(--border)}

/* ------------------------------------------------------------------ hero */
.hero{padding-top:clamp(120px,15vw,190px); padding-bottom:0; overflow:hidden}
.glow{position:absolute; inset:0; overflow:hidden; pointer-events:none; z-index:0}
.glow::before{
  content:""; position:absolute; top:-340px; left:50%; transform:translateX(-50%);
  width:1200px; height:760px; border-radius:50%;
  background:radial-gradient(ellipse at center, rgba(124,92,255,.34), rgba(124,92,255,.10) 42%, transparent 68%);
  filter:blur(28px);
}
.glow::after{
  content:""; position:absolute; top:60px; right:-160px; width:620px; height:520px; border-radius:50%;
  background:radial-gradient(ellipse at center, rgba(34,211,238,.16), transparent 66%);
  filter:blur(34px);
}
.grid-bg{
  position:absolute; inset:0; z-index:0; pointer-events:none; opacity:.5;
  background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
  background-size:72px 72px;
  -webkit-mask-image:radial-gradient(ellipse 78% 58% at 50% 12%,#000 20%,transparent 76%);
          mask-image:radial-gradient(ellipse 78% 58% at 50% 12%,#000 20%,transparent 76%);
}
.badge{
  display:inline-flex; align-items:center; gap:9px; padding:7px 15px 7px 11px; border-radius:999px;
  border:1px solid var(--border); background:rgba(28,28,41,.7);
  font-size:12.8px; color:var(--dim); font-weight:500;
}
.dot{width:6px; height:6px; border-radius:50%; background:var(--ok); box-shadow:0 0 0 4px rgba(52,211,153,.16); flex:none}
.hero h1{font-size:clamp(34px,5.4vw,64px); font-weight:800; letter-spacing:-.035em; margin:26px 0 0; line-height:1.12}
.hero h1 .g{
  background:linear-gradient(100deg,#B9A6FF 0%,#7C5CFF 42%,#22D3EE 100%);
  -webkit-background-clip:text; background-clip:text; color:transparent;
}
/* La parola che porta tutto il peso del messaggio: sta su una riga sua. */
.hero h1 .prima{
  display:block; font-size:1.75em; font-weight:900; letter-spacing:-.02em;
  line-height:.98; margin:.06em 0 .02em;
}
.hero .lede{font-size:clamp(16.5px,1.8vw,20px); margin-top:26px}
.cta-row{display:flex; flex-wrap:wrap; gap:14px; margin-top:38px; align-items:center}
.microcopy{margin-top:18px; color:var(--faint); font-size:13.5px}
.microcopy b{color:var(--dim); font-weight:600}

.shot{position:relative; margin-top:clamp(52px,7vw,86px)}
.shot::before{
  content:""; position:absolute; left:50%; top:14%; transform:translateX(-50%);
  width:82%; height:74%; border-radius:50%; z-index:0;
  background:radial-gradient(ellipse at center, rgba(124,92,255,.5), rgba(34,211,238,.18) 46%, transparent 72%);
  filter:blur(72px);
}
.shot .frame{position:relative; z-index:1; border-radius:14px}
.shot img{
  border-radius:14px; width:100%;
  box-shadow:0 70px 130px -50px rgba(0,0,0,.95), 0 0 0 1px rgba(255,255,255,.07);
}
.shot-cap{position:relative; z-index:2; margin-top:20px; text-align:center; color:var(--faint); font-size:12.8px}
.only-mobile{display:none}

/* ------------------------------------------------------------ striscia n */
.stats{
  display:grid; grid-template-columns:repeat(4,1fr); gap:1px;
  background:var(--border-soft); border:1px solid var(--border-soft); border-radius:18px; overflow:hidden;
}
.stat{background:linear-gradient(180deg,#101019,#0D0D15); padding:30px 24px; text-align:center}
.stat .n{font-size:clamp(24px,3.2vw,38px); font-weight:800; letter-spacing:-.03em; font-family:var(--mono)}
.stat .n.g{background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent}
.stat .l{color:var(--faint); font-size:12.5px; margin-top:8px; line-height:1.4}

/* ----------------------------------------------------------------- card */
.card{
  position:relative; overflow:hidden;
  background:linear-gradient(180deg,#15151F 0%,#101019 100%);
  border:1px solid var(--border-soft); border-radius:20px; padding:28px;
  transition:transform .3s cubic-bezier(.2,.7,.3,1), border-color .3s, box-shadow .3s;
}
.card::before{
  content:""; position:absolute; inset:0; opacity:0; transition:opacity .35s; pointer-events:none;
  background:radial-gradient(420px circle at var(--mx,50%) var(--my,0%), rgba(124,92,255,.14), transparent 62%);
}
.card:hover{transform:translateY(-5px); border-color:#37375A; box-shadow:0 26px 60px -28px rgba(124,92,255,.55)}
.card:hover::before{opacity:1}
.card h3{margin-bottom:10px}
.card p{color:var(--dim); font-size:14.6px}
.card .ic{
  width:40px; height:40px; border-radius:12px; display:grid; place-items:center; margin-bottom:18px;
  background:rgba(124,92,255,.12); border:1px solid rgba(124,92,255,.3); color:var(--accent-hi);
}
.card .ic svg{width:19px; height:19px; stroke:currentColor; fill:none; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round}
.grid-3{display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:52px}
.grid-2{display:grid; grid-template-columns:repeat(2,1fr); gap:20px; margin-top:52px}

/* -------------------------------------------------------------- domande */
.qa{display:grid; grid-template-columns:repeat(2,1fr); gap:18px; margin-top:52px}
.qa-item{
  border:1px solid var(--border-soft); border-radius:18px; padding:26px 26px 24px;
  background:linear-gradient(180deg,rgba(21,21,31,.9),rgba(13,13,21,.9));
  transition:border-color .3s, background .3s;
}
.qa-item:hover{border-color:#37375A}
.qa-q{color:var(--faint); font-size:14px; font-style:italic}
.qa-a{margin-top:14px; font-size:17px; font-weight:600; letter-spacing:-.01em}
.chip{
  display:inline-flex; align-items:center; gap:8px; margin-top:16px;
  padding:7px 13px; border-radius:9px; font-family:var(--mono); font-size:12.6px;
  background:#0C0C14; border:1px solid var(--border); color:var(--dim);
}
.chip .sq{width:7px; height:7px; border-radius:2px; background:var(--accent); flex:none}
.chip.ok .sq{background:var(--ok)} .chip.warn .sq{background:var(--warn)}

/* -------------------------------------------------------------- tabella */
.tablewrap{overflow-x:auto; margin-top:44px; border:1px solid var(--border-soft); border-radius:18px; background:#0E0E16}
table{border-collapse:collapse; width:100%; min-width:620px; font-size:14.6px}
th,td{padding:16px 20px; text-align:left; border-bottom:1px solid var(--border-soft)}
thead th{
  color:var(--faint); font-size:11.5px; font-weight:700; letter-spacing:.12em; text-transform:uppercase;
  background:#0B0B12;
}
tbody tr{transition:background .2s}
tbody tr:hover{background:rgba(124,92,255,.05)}
tbody tr:last-child td{border-bottom:none}
td.num{font-family:var(--mono); font-variant-numeric:tabular-nums; white-space:nowrap}
.free{color:var(--ok); font-weight:700}
.tag{
  display:inline-block; padding:3px 9px; border-radius:6px; font-size:11.5px; font-weight:700;
  letter-spacing:.04em; text-transform:uppercase; white-space:nowrap;
}
.tag.serie{background:rgba(124,92,255,.16); color:var(--accent-hi); border:1px solid rgba(124,92,255,.3)}
.tag.opt{background:rgba(255,255,255,.05); color:var(--faint); border:1px solid var(--border)}

/* --------------------------------------------------------------- preset */
.presets{display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-top:52px}
.preset{
  position:relative; overflow:hidden; padding:22px;
  border:1px solid var(--border-soft); border-radius:16px; background:#101019;
  transition:transform .28s cubic-bezier(.2,.7,.3,1), border-color .28s, background .28s;
}
.preset::after{
  content:""; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--grad);
  transform:scaleY(0); transform-origin:top; transition:transform .3s;
}
.preset:hover{transform:translateY(-4px); border-color:#37375A; background:#13131E}
.preset:hover::after{transform:scaleY(1)}
.preset .pn{font-weight:700; font-size:15.5px; letter-spacing:-.01em}
.preset .pm{color:var(--faint); font-size:12.4px; margin-top:7px}
.preset .pp{
  margin-top:14px; font-family:var(--mono); font-size:11.6px; color:var(--accent-hi);
  background:rgba(124,92,255,.09); border:1px solid rgba(124,92,255,.18);
  border-radius:7px; padding:6px 9px; display:inline-block;
}

/* ------------------------------------------------------------- due col */
.split{display:grid; grid-template-columns:1fr 1fr; gap:clamp(32px,5vw,72px); align-items:center; margin-top:52px}
.figure{position:relative}
.figure::before{
  content:""; position:absolute; inset:-10% -6%; z-index:0; border-radius:50%;
  background:radial-gradient(ellipse at center, rgba(124,92,255,.34), transparent 68%); filter:blur(56px);
}
.figure img{
  position:relative; z-index:1; border-radius:16px;
  box-shadow:0 40px 90px -40px rgba(0,0,0,.95), 0 0 0 1px rgba(255,255,255,.07);
}
.rules{list-style:none; padding:0; margin:0; counter-reset:r}
.rules li{
  counter-increment:r; position:relative; padding:16px 0 16px 54px;
  border-bottom:1px solid var(--border-soft); color:var(--dim); font-size:15px;
}
.rules li:last-child{border-bottom:none}
.rules li::before{
  content:counter(r,decimal-leading-zero); position:absolute; left:0; top:15px;
  font-family:var(--mono); font-size:12px; font-weight:700; color:var(--accent-hi);
  width:32px; height:26px; display:grid; place-items:center;
  border:1px solid rgba(124,92,255,.3); border-radius:7px; background:rgba(124,92,255,.09);
}
.rules b{color:var(--text); font-weight:600}

/* ------------------------------------------------------------- citazione */
.quote{
  margin-top:52px; padding:clamp(32px,5vw,58px); border-radius:24px; text-align:center;
  background:linear-gradient(180deg,rgba(124,92,255,.13),rgba(34,211,238,.05));
  border:1px solid rgba(124,92,255,.24); position:relative; overflow:hidden;
}
.quote .big{
  font-family:var(--mono); font-size:clamp(17px,3vw,30px); font-weight:500; letter-spacing:-.02em;
  color:#fff; line-height:1.35;
}
.quote .big em{color:var(--warn); font-style:normal}
.quote .sub{color:var(--dim); margin-top:20px; font-size:15px; max-width:620px; margin-left:auto; margin-right:auto}

/* -------------------------------------------------------------- galleria */
.gallery{display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:52px}
.tile{
  position:relative; border-radius:16px; overflow:hidden; border:1px solid var(--border-soft);
  aspect-ratio:4/5; display:flex; flex-direction:column; justify-content:flex-end;
  padding:20px; transition:transform .3s cubic-bezier(.2,.7,.3,1), border-color .3s, box-shadow .3s;
}
.tile:hover{transform:translateY(-5px); border-color:#3B3B60; box-shadow:0 30px 60px -30px rgba(0,0,0,.9)}
.tile .art{position:absolute; inset:0; z-index:0}
.tile .art img{position:absolute; inset:0; width:100%; height:100%; object-fit:cover}
.tile .art::after{
  content:""; position:absolute; inset:0;
  background:linear-gradient(180deg,rgba(11,11,18,0) 30%,rgba(11,11,18,.86) 82%,rgba(11,11,18,.96));
}
.tile .meta{position:relative; z-index:1}
.tile .pname{font-weight:700; font-size:14.5px}
.tile .ptext{color:var(--dim); font-size:12.6px; margin-top:5px; line-height:1.45}
.tile .pset{margin-top:11px; font-family:var(--mono); font-size:11px; color:var(--faint)}
.tile .slot{
  position:absolute; top:14px; left:14px; z-index:1; padding:5px 10px; border-radius:7px;
  font-size:10.5px; font-weight:600; letter-spacing:.06em; text-transform:uppercase;
  background:rgba(11,11,18,.6); border:1px solid rgba(255,255,255,.12); color:var(--dim);
  backdrop-filter:blur(6px);
}
.a1{background:radial-gradient(120% 80% at 20% 10%,#3B2E6B,#141422 60%,#0D0D15)}
.a2{background:radial-gradient(120% 80% at 80% 15%,#123C4A,#111A26 58%,#0D0D15)}
.a3{background:radial-gradient(120% 80% at 40% 0%,#4A2547,#1B1524 60%,#0D0D15)}
.a4{background:radial-gradient(120% 80% at 70% 20%,#2A3A6B,#131826 58%,#0D0D15)}
.a5{background:radial-gradient(120% 80% at 25% 15%,#5A3A22,#221A18 60%,#0D0D15)}
.a6{background:radial-gradient(120% 80% at 60% 5%,#1F4740,#12201E 58%,#0D0D15)}

/* --------------------------------------------------------------- codice */
.code{
  margin-top:26px; border:1px solid var(--border-soft); border-radius:14px; background:#0A0A11;
  overflow-x:auto; padding:20px 22px; font-family:var(--mono); font-size:12.6px;
  color:var(--dim); line-height:1.7; white-space:pre;
}
.code .k{color:var(--accent-hi)}
.code .s{color:#6FE0BC}
.code .c{color:var(--faint)}
/* <pre> e non <div>: Astro comprime gli spazi fuori da pre, e il blocco
   finirebbe su una riga sola. */
pre.code{margin:26px 0 0}
.guards{display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:26px}
.guard{
  border:1px solid var(--border-soft); border-radius:16px; padding:22px; background:#101019;
  transition:border-color .3s, transform .28s cubic-bezier(.2,.7,.3,1);
}
.guard:hover{border-color:#37375A; transform:translateY(-4px)}
.guard b{display:block; font-size:15px; margin-bottom:8px}
.guard p{color:var(--dim); font-size:14px}
.guard .no{
  display:inline-block; font-family:var(--mono); font-size:11px; letter-spacing:.06em;
  text-transform:uppercase; color:var(--danger); border:1px solid rgba(248,113,113,.32);
  background:rgba(248,113,113,.08); border-radius:6px; padding:3px 8px; margin-bottom:12px;
}

/* -------------------------------------------------------------- limiti */
.limits-box{margin-top:40px}
.limits-toggle{
  list-style:none; cursor:pointer; display:inline-flex; align-items:center; gap:12px;
  height:52px; padding:0 26px; border-radius:999px; font-weight:700; font-size:15px;
  border:1px solid rgba(251,191,36,.35); background:rgba(251,191,36,.07); color:var(--warn);
  transition:background .25s, border-color .25s, transform .18s cubic-bezier(.2,.7,.3,1);
}
.limits-toggle::-webkit-details-marker{display:none}
.limits-toggle:hover{background:rgba(251,191,36,.14); border-color:rgba(251,191,36,.6); transform:translateY(-2px)}
.limits-toggle::after{
  content:""; width:8px; height:8px; margin-left:2px;
  border-right:2px solid currentColor; border-bottom:2px solid currentColor;
  transform:translateY(-2px) rotate(45deg); transition:transform .3s;
}
.limits-box[open] .limits-toggle::after{transform:translateY(1px) rotate(-135deg)}
.limits-toggle .chiudi{display:none}
.limits-box[open] .limits-toggle .apri{display:none}
