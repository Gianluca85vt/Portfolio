---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../data/portfolio';

// Plain language on purpose: what is collected, by whom, why, and how to say
// no. Keep it true to what the code does — if a new service starts receiving
// visitor data, it belongs in this list before it ships.
const updated = '25 September 2026';

const sections: { title: string; body: string[] }[] = [
  {
    title: 'Who is responsible',
    body: [
      `${site.name}, who runs this site, is the data controller. For anything about your data, write to <a href="mailto:${site.email}">${site.email}</a>.`,
    ],
  },
  {
    title: 'Visiting the site',
    body: [
      'The site is hosted on Vercel. Like any web server, it receives your IP address, browser and the page requested in order to deliver the page and keep the service secure. That is necessary to run the site, and it is not used to profile you.',
      'Article images are served through this domain from the jsDelivr CDN, and fonts are served by the site itself — no request goes to Google Fonts.',
    ],
  },
  {
    title: 'Analytics — only if you agree',
    body: [
      'If you click “Accept” in the banner, Google Analytics 4 (Google Ireland Ltd.) is loaded. It sets cookies and records which pages are read, how the visit arrived and roughly where from, so I can see what is worth writing. Google may process this data outside the EU under its own safeguards. It is kept for the retention period set in the Analytics property.',
      'If you click “Decline”, or do nothing, Analytics is not loaded and no analytics cookie is set. You can change your answer at any time with the button below; it applies to this browser.',
    ],
  },
  {
    title: 'Comments',
    body: [
      'If you comment, the name you type and your comment are stored and published under the article. A one-way, salted hash of your IP address is stored alongside, only to limit how many comments can be posted in a row; it cannot be turned back into the address. The comments are stored with Supabase, and I receive an email for each one.',
      'Reading an article loads its comments directly from Supabase, which therefore sees the request. Ask by email and I will remove a comment of yours.',
    ],
  },
  {
    title: 'Videos and share buttons',
    body: [
      'Embedded videos are a still image until you click them. Only then is the player loaded from youtube-nocookie.com, and YouTube’s own terms apply from that point.',
      'The share buttons are plain links. Nothing is sent to WhatsApp, X, Facebook or LinkedIn unless you click one.',
    ],
  },
  {
    title: 'Stored on your device',
    body: [
      'Two settings may be kept in your browser’s local storage: your analytics answer (gs-consent) and, on the site owner’s own devices, an analytics exclusion flag (gs-no-track). Neither is sent anywhere.',
    ],
  },
  {
    title: 'Your rights',
    body: [
      'Under the GDPR you can ask to access, correct or delete your data, to restrict or object to its use, and to receive it in a portable form. Write to the address above. You can also complain to the Italian supervisory authority, the Garante per la protezione dei dati personali (garanteprivacy.it).',
    ],
  },
];
---

<Base
  title={`Privacy — ${site.name}`}
  description="What this site collects, who processes it, and how to change your analytics choice."
>
  <div class="min-h-screen flex flex-col" style="overflow-x:clip">
    <SiteHeader />

    <section class="px-5 sm:px-8 md:px-10 pt-14 sm:pt-20 pb-24">
      <div class="max-w-[720px] mx-auto">
        <h1
          class="hero-heading font-black uppercase leading-none tracking-tight"
          style="font-size:clamp(2rem, 6vw, 3.5rem)"
        >
          Privacy
        </h1>
        <p class="text-[#D7E2EA]/45 font-light text-[0.84rem] mt-4">Last updated {updated}</p>

        <div class="privacy mt-10 space-y-10">
          {
            sections.map((s) => (
              <section>
                <h2 class="text-[#D7E2EA] font-medium uppercase tracking-[0.12em] text-[0.8rem]">
                  {s.title}
                </h2>
                {s.body.map((p) => (
                  <p
                    class="text-[#D7E2EA]/70 font-light text-[0.95rem] leading-relaxed mt-3"
                    set:html={p}
                  />
                ))}
              </section>
            ))
          }
        </div>

        <div
          class="mt-12 rounded-[16px] border p-7"
          style="border-color:rgba(215,226,234,0.15)"
        >
          <p id="consent-label" class="text-[#D7E2EA] font-medium">Checking…</p>
          <div class="flex flex-wrap gap-3 mt-5">
            <button
              type="button"
              data-set="granted"
              class="rounded-full px-7 py-3 font-medium uppercase tracking-widest text-[0.7rem] text-white transition-opacity duration-200 hover:opacity-90"
              style="background:linear-gradient(123deg,#18011F 7%,#B600A8 37%,#7621B0 72%,#BE4C00 100%)"
            >
              Allow analytics
            </button>
            <button
              type="button"
              data-set="denied"
              class="rounded-full px-7 py-3 font-medium uppercase tracking-widest text-[0.7rem] text-[#D7E2EA] border border-[#D7E2EA]/35 transition-colors duration-200 hover:bg-[#D7E2EA]/10"
            >
              Refuse analytics
            </button>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var label = document.getElementById('consent-label');

      function current() {
        try {
          return localStorage.getItem('gs-consent');
        } catch (e) {
          return null;
        }
      }

      function paint() {
        var value = current();
        label.textContent =
          value === 'granted'
            ? 'Analytics is allowed in this browser.'
            : value === 'denied'
              ? 'Analytics is refused in this browser.'
              : 'You have not chosen yet, so analytics is off.';
      }

      // Withdrawing consent should not leave Google's cookies behind. They are
      // set on the registrable domain, so each is expired there and host-only.
      function dropAnalyticsCookies() {
        var host = location.hostname;
        var domains = ['', host, host.replace(/^www\./, ''), '.' + host.replace(/^www\./, '')];
        document.cookie.split(';').forEach(function (part) {
          var name = part.split('=')[0].trim();
          if (!/^_ga/.test(name)) return;
          domains.forEach(function (d) {
            document.cookie =
              name + '=; Path=/; Max-Age=0' + (d ? '; Domain=' + d : '');
          });
        });
      }

      document.querySelectorAll('[data-set]').forEach(function (button) {
        button.addEventListener('click', function () {
          var value = button.getAttribute('data-set');
          try {
            localStorage.setItem('gs-consent', value);
          } catch (e) {}
          if (value === 'denied') dropAnalyticsCookies();
          // The tag is decided at page load, so reload to apply the answer; it
          // also hides the banner if it was still showing.
          location.reload();
        });
      });

      paint();
    })();
  </script>
</Base>

<style>
  .privacy :global(a) {
    text-decoration: underline;
    text-decoration-color: rgba(182, 0, 168, 0.7);
    text-underline-offset: 2px;
  }
</style>
