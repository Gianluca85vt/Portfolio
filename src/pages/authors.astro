---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getCollection } from 'astro:content';
import { personas, aiDisclosure } from '../data/personas';
import { site } from '../data/portfolio';

const entries = await getCollection('blog', ({ data }) => !data.draft);
const counts: Record<string, number> = {};
for (const e of entries) {
  if (e.data.author) counts[e.data.author] = (counts[e.data.author] ?? 0) + 1;
}

// Only show personas who have actually published something, so the page never
// advertises a byline with nothing behind it.
const active = personas.filter((p) => counts[p.id]);
const idle = personas.filter((p) => !counts[p.id]);

const title = `Who writes here — ${site.name}`;
const description =
  'The blog publishes under invented editorial personas, with AI assistance, reviewed before publication. Here is exactly how that works.';
---

<Base title={title} description={description}>
  <div class="min-h-screen flex flex-col" style="overflow-x:clip">
    <SiteHeader current="/blog" />

    <section class="px-5 sm:px-8 md:px-10 pt-12 sm:pt-16 pb-20 sm:pb-24">
      <div class="max-w-[760px] mx-auto">
        <h1
          class="hero-heading font-black uppercase leading-[1.05] tracking-tight"
          style="font-size:clamp(2rem, 6vw, 3.4rem)"
        >
          Who writes here
        </h1>

        {/* The important part goes first, not at the bottom. */}
        <div
          class="mt-8 rounded-[16px] border p-6 sm:p-7"
          style="border-color:rgba(182,0,168,0.35); background:rgba(182,0,168,0.05)"
        >
          <p class="text-[#D7E2EA] font-medium text-[0.95rem] leading-relaxed">
            The names below are invented. They are not real people.
          </p>
          <p class="text-[#D7E2EA]/60 font-light text-[0.9rem] leading-relaxed mt-3">
            {aiDisclosure.long}
          </p>
        </div>

        <h2 class="text-[#D7E2EA]/45 font-medium uppercase tracking-[0.14em] text-[0.66rem] mt-14 pb-3 border-b border-[#D7E2EA]/15">
          Why bylines at all
        </h2>
        <p class="text-[#D7E2EA]/65 font-light leading-relaxed mt-5 text-[0.95rem]">
          Because a section reads better when the same voice covers it. A piece
          about a render pipeline and a piece about a studio closing want
          different instincts, and giving each one a persona keeps them from
          blurring into one flat house style. Two per section, split along a real
          difference in approach rather than a different name on the same prose.
        </p>
        <p class="text-[#D7E2EA]/65 font-light leading-relaxed mt-4 text-[0.95rem]">
          What they are not is a way to pretend a newsroom exists. Every article
          says <em>AI-assisted, invented byline</em> directly under the name, and
          links here.
        </p>

        <h2 class="text-[#D7E2EA]/45 font-medium uppercase tracking-[0.14em] text-[0.66rem] mt-14 pb-3 border-b border-[#D7E2EA]/15">
          The bylines
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5 mt-6">
          {
            active.map((p) => (
              <div id={p.id} class="rounded-[14px] border border-[#D7E2EA]/15 p-5 scroll-mt-24">
                <div class="flex items-center gap-3">
                  <span
                    class="flex items-center justify-center shrink-0 w-11 h-11 rounded-full text-white font-medium text-[0.78rem]"
                    style={`background:linear-gradient(140deg, #18011F 10%, ${p.color} 150%)`}
                    aria-hidden="true"
                  >
                    {p.initials}
                  </span>
                  <div class="min-w-0">
                    <p class="text-[#D7E2EA] font-medium text-[0.95rem] leading-tight">{p.name}</p>
                    <p class="text-[#D7E2EA]/40 font-light text-[0.72rem] leading-tight mt-0.5">
                      {p.role}
                    </p>
                  </div>
                </div>

                <p class="text-[#D7E2EA]/60 font-light text-[0.85rem] leading-relaxed mt-4">
                  {p.bio}
                </p>

                <p class="text-[#D7E2EA]/30 font-light text-[0.7rem] mt-4">
                  {counts[p.id]} {counts[p.id] === 1 ? 'article' : 'articles'}
                </p>
              </div>
            ))
          }
        </div>

        {
          idle.length > 0 && (
            <p class="text-[#D7E2EA]/35 font-light text-[0.82rem] leading-relaxed mt-6">
              Also defined but not yet published:{' '}
              {idle.map((p) => p.name).join(', ')}.
            </p>
          )
        }

        <a
          href="/blog/"
          class="inline-flex items-center gap-2 rounded-full border-2 border-[#D7E2EA]/50 text-[#D7E2EA] font-medium uppercase tracking-widest px-7 py-3 text-xs sm:text-sm transition-colors duration-300 hover:bg-[#D7E2EA]/10 mt-14"
        >
          Back to the blog
        </a>
      </div>
    </section>
  </div>
</Base>
