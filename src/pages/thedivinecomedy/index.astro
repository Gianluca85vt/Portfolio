<style is:global>
:root{
  --bg:#07080d; --bg2:#0c0d13; --surface:#12131a; --line:#2a2620; --line2:#3a332a;
  --ink:#ece3d2; --dim:#b5aa94; --faint:#7f7666; --gold:#c9a45c; --gold-hi:#e6c682; --ember:#d0532c;
  --serif:"EB Garamond", Georgia, "Times New Roman", serif; --caps:"Cinzel", Georgia, serif;
  --wrap:1180px;
}
*{box-sizing:border-box}
[hidden]{display:none !important}
html{scroll-behavior:smooth}
body{margin:0; background:var(--bg); color:var(--ink); font-family:var(--serif); font-size:19px; line-height:1.6; -webkit-font-smoothing:antialiased; overflow-x:hidden}
body::after{content:""; position:fixed; inset:0; pointer-events:none; z-index:50; opacity:.06;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>")}
img{max-width:100%; display:block}
a{color:inherit}
h1,h2,h3{margin:0; font-weight:600}
p{margin:0}
button{font:inherit; color:inherit}
.wrap{max-width:var(--wrap); margin:0 auto; padding:0 28px}
.kicker{font-family:var(--caps); font-size:13px; letter-spacing:.24em; text-transform:uppercase; color:var(--gold)}
.sr{position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap}

/* nav */
.nav{position:fixed; top:0; left:0; right:0; z-index:20; display:flex; align-items:center; justify-content:space-between; gap:24px;
  padding:18px 28px; background:linear-gradient(to bottom, rgba(7,8,13,.88), rgba(7,8,13,0)); pointer-events:none}
.nav > *{pointer-events:auto}
.marchio{font-family:var(--caps); font-size:14px; letter-spacing:.22em; text-decoration:none; color:var(--ink); white-space:nowrap}
.nav-link{display:flex; gap:26px}
.nav-link a, .nav-destra a{font-family:var(--caps); font-size:12px; letter-spacing:.2em; text-transform:uppercase; text-decoration:none; color:var(--dim); transition:color .2s}
.nav-link a:hover, .nav-destra a:hover{color:var(--gold-hi)}
.nav-destra{display:flex; gap:20px; align-items:center}
.lingua{border:1px solid var(--line2); border-radius:999px; padding:4px 11px}
.musica{display:inline-flex; align-items:center; gap:8px; background:none; border:1px solid var(--line2); border-radius:999px; padding:4px 11px;
  cursor:pointer; font-family:var(--caps); font-size:12px; letter-spacing:.2em; text-transform:uppercase; color:var(--dim); transition:color .2s}
.musica:hover, .musica.acceso{color:var(--gold-hi)}
.musica .barre{display:inline-flex; align-items:flex-end; gap:2px; height:11px}
.musica .barre i{display:block; width:2px; height:3px; background:currentColor; border-radius:1px}
.musica .barre i:nth-child(1){height:5px}
.musica .barre i:nth-child(2){height:10px}
.musica .barre i:nth-child(3){height:7px}
.musica.acceso .barre i{animation:tdc-barra 1.1s ease-in-out infinite alternate}
.musica.acceso .barre i:nth-child(2){animation-delay:-.4s}
.musica.acceso .barre i:nth-child(3){animation-delay:-.8s}
@keyframes tdc-barra{from{height:3px} to{height:11px}}

/* la mappa */
#tdc-stage{position:relative; height:100vh; height:100svh; min-height:560px; overflow:hidden; background:var(--bg)}
#tdc-canvas{position:absolute; inset:0; width:100%; height:100%; display:block; cursor:grab; touch-action:pan-y}
#tdc-canvas:active{cursor:grabbing}
.velo{position:absolute; inset:0; pointer-events:none; z-index:1;
  background:radial-gradient(ellipse at 55% 50%, rgba(7,8,13,0) 52%, rgba(4,4,8,.8) 100%),
             linear-gradient(to bottom, rgba(7,8,13,.55), rgba(7,8,13,0) 24%, rgba(7,8,13,0) 72%, rgba(7,8,13,1))}
.hero-testo{position:absolute; left:6vw; top:20vh; z-index:3; max-width:520px; pointer-events:none}
.hero-testo .azioni{pointer-events:auto}
.hero-testo .di{font-family:var(--caps); font-size:12px; letter-spacing:.26em; text-transform:uppercase; color:var(--dim)}
.hero-testo img{width:min(380px, 72vw); height:auto; margin:14px 0 18px; filter:drop-shadow(0 6px 24px rgba(0,0,0,.8))}
.motto{font-style:italic; font-size:clamp(20px, 2vw, 26px); line-height:1.35; color:var(--ink); text-shadow:0 2px 14px rgba(0,0,0,.9)}
.azioni{display:flex; flex-wrap:wrap; gap:12px; margin-top:26px}
.bottone{display:inline-flex; align-items:center; gap:10px; font-family:var(--caps); font-size:12px; letter-spacing:.2em; text-transform:uppercase;
  text-decoration:none; padding:13px 20px; border-radius:2px; border:1px solid var(--gold); color:var(--bg); background:var(--gold); cursor:pointer; transition:background .2s, color .2s}
.bottone:hover{background:var(--gold-hi)}
.bottone.vuoto{background:rgba(7,8,13,.4); color:var(--gold-hi)}
.bottone.vuoto:hover{background:rgba(201,164,92,.14)}
.suggerimento{position:absolute; left:6vw; bottom:30px; z-index:3; font-family:var(--caps); font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:var(--faint)}
#tdc-pins{position:absolute; inset:0; z-index:4; pointer-events:none; opacity:0; transition:opacity 1.2s}
#tdc-stage.pronto #tdc-pins{opacity:1}
.tdc-pin{position:absolute; left:0; top:0; pointer-events:auto; display:inline-flex; align-items:center; gap:0; cursor:pointer;
  font-family:var(--caps); font-size:12px; letter-spacing:.12em; color:var(--gold-hi); white-space:nowrap;
  background:rgba(8,8,12,.62); border:1px solid rgba(230,198,130,.38); border-radius:999px; padding:4px 10px; backdrop-filter:blur(4px);
  transition:opacity .3s, border-color .2s, background .2s}
.tdc-pin .nome{max-width:0; overflow:hidden; opacity:0; transition:max-width .35s, opacity .25s, margin .35s; font-family:var(--serif); font-size:14px; letter-spacing:0; text-transform:none; color:var(--ink)}
.tdc-pin:hover, .tdc-pin:focus-visible, .tdc-pin.scelto{border-color:var(--gold-hi); background:rgba(20,16,10,.85); outline:none}
.tdc-pin:hover .nome, .tdc-pin:focus-visible .nome, .tdc-pin.scelto .nome{max-width:220px; opacity:1; margin-left:8px}
.tdc-pin.fuori{opacity:0; pointer-events:none}
.tdc-index{position:absolute; right:26px; top:50%; transform:translateY(-50%); z-index:3; display:flex; flex-direction:column; gap:2px}
.tdc-index button{display:flex; justify-content:flex-end; align-items:baseline; gap:10px; background:none; border:0; padding:5px 4px; cursor:pointer; color:var(--faint); text-align:right; transition:color .2s}
.tdc-index button .n{font-family:var(--caps); font-size:12px; min-width:26px; text-align:right}
.tdc-index button .t{font-size:15px}
.tdc-index button:hover, .tdc-index button[aria-current="true"]{color:var(--gold-hi)}
.caricamento{position:absolute; inset:0; z-index:8; display:grid; place-items:center; background:var(--bg); transition:opacity 1.4s ease; pointer-events:none}
.caricamento p{font-style:italic; font-size:22px; color:var(--gold); letter-spacing:.02em}
#tdc-stage:not(.loading) .caricamento{opacity:0}
.nogl-avviso{display:none}
#tdc-stage.nogl #tdc-canvas, #tdc-stage.nogl #tdc-pins, #tdc-stage.nogl .suggerimento{display:none}
#tdc-stage.nogl{background:url("img/leone.webp") center/cover}
#tdc-stage.nogl .nogl-avviso{display:block; position:absolute; right:26px; bottom:30px; z-index:3; max-width:300px; font-size:15px; color:var(--dim); text-align:right}

/* scheda del cerchio */
#tdc-panel{position:absolute; top:0; right:0; bottom:0; z-index:6; width:min(470px, 100%); overflow-y:auto; overscroll-behavior:contain;
  background:linear-gradient(to right, rgba(9,9,14,.93), rgba(9,9,14,.98)); border-left:1px solid var(--line);
  padding:132px 38px 44px; transform:translateX(100%); transition:transform .5s cubic-bezier(.2,.7,.2,1)}
#tdc-panel.aperto{transform:none}
.p-chiudi{position:absolute; top:80px; right:26px; z-index:2; width:38px; height:38px; border-radius:50%; border:1px solid var(--line2); background:rgba(9,9,14,.85); cursor:pointer; color:var(--dim); font-size:20px; line-height:1}
.hero-testo, .suggerimento{transition:opacity .5s}
#tdc-stage.scheda .hero-testo, #tdc-stage.scheda .suggerimento{opacity:0; pointer-events:none}
#tdc-stage.scheda .hero-testo .azioni{pointer-events:none}
.p-chiudi:hover{color:var(--gold-hi); border-color:var(--gold)}
.p-img{width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:4px; margin:4px 0 22px;
  -webkit-mask-image:linear-gradient(to bottom, #000 72%, transparent); mask-image:linear-gradient(to bottom, #000 72%, transparent)}
.p-titolo{font-family:var(--caps); font-size:38px; line-height:1.1; margin-top:10px; color:var(--ink)}
.p-nome-it{font-style:italic; color:var(--dim); margin-top:6px; font-size:18px}
.p-canto{font-family:var(--caps); font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:var(--faint); margin-top:4px}
.p-sezioni h3{font-family:var(--caps); font-size:12px; letter-spacing:.22em; text-transform:uppercase; color:var(--gold); margin:26px 0 6px}
.p-sezioni p{font-size:18px; line-height:1.6; color:var(--ink)}
.p-verso{margin:30px 0 0; padding:20px 0 0; border-top:1px solid var(--line)}
.p-verso-it{font-style:italic; font-size:19px; line-height:1.5; white-space:pre-line; color:var(--gold-hi)}
.p-verso-en{font-size:16px; line-height:1.5; white-space:pre-line; color:var(--dim); margin-top:10px}
.p-cita{font-family:var(--caps); font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:var(--faint); margin-top:10px}
.p-gioco-box{margin-top:26px; display:flex; flex-direction:column; gap:8px}
.p-gioco-box .kicker{font-size:11px}
.p-gioco{display:inline-block; align-self:flex-start; font-size:16px; padding:8px 14px; border-radius:3px; border:1px solid var(--line2); color:var(--dim)}
.p-gioco[data-stato="ora"]{border-color:#5f8a52; color:#cfe8c0; background:rgba(95,138,82,.12)}
.p-gioco[data-stato="demo"]{border-color:var(--gold); color:var(--gold-hi); background:rgba(201,164,92,.1)}
.p-passi{display:flex; justify-content:space-between; gap:12px; margin-top:34px}
.p-passi button{background:none; border:1px solid var(--line2); border-radius:2px; padding:10px 14px; cursor:pointer; font-family:var(--caps); font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:var(--dim)}
.p-passi button:hover:not(:disabled){border-color:var(--gold); color:var(--gold-hi)}
.p-passi button:disabled{opacity:.3; cursor:default}

/* sezioni */
.sezione{padding:clamp(80px, 10vw, 150px) 0; position:relative}
.sezione h2{font-family:var(--caps); font-size:clamp(34px, 4.2vw, 58px); line-height:1.08; color:var(--gold-hi); margin:12px 0 22px}
.sezione .intro{max-width:720px; font-size:21px; color:var(--ink)}
.riga{height:1px; background:linear-gradient(90deg, transparent, var(--line2) 18%, var(--line2) 82%, transparent)}
.due{display:grid; grid-template-columns:1.05fr .95fr; gap:clamp(32px, 6vw, 80px); align-items:center}
.due img{border-radius:6px; border:1px solid var(--line); aspect-ratio:4/3; object-fit:cover; width:100%; height:auto}
.tratti{display:grid; grid-template-columns:repeat(3, 1fr); gap:26px; margin-top:56px}
.tratto{border-top:1px solid var(--gold); padding-top:18px}
.tratto h3{font-family:var(--caps); font-size:19px; color:var(--ink); margin-bottom:8px}
.tratto p{color:var(--dim); font-size:17px}
.personaggi{display:grid; grid-template-columns:repeat(3, 1fr); gap:28px; margin-top:44px}
.persona .ritratto{height:430px; border-radius:8px; border:1px solid var(--line); overflow:hidden;
  background:radial-gradient(circle at 50% 38%, #2a211b 0%, #0e0c0b 72%); display:flex; align-items:flex-end; justify-content:center}
.persona .ritratto img{height:100%; width:100%; object-fit:contain; object-position:bottom center}
.persona h3{font-family:var(--caps); font-size:26px; color:var(--gold-hi); margin:18px 0 6px}
.persona p{color:var(--dim); font-size:17px}
.galleria{display:grid; grid-template-columns:repeat(12, 1fr); gap:10px; margin-top:40px}
.galleria button{grid-column:span 3; padding:0; border:0; background:none; cursor:zoom-in; border-radius:4px; overflow:hidden; position:relative; aspect-ratio:16/9}
.galleria button:nth-child(-n+3){grid-column:span 4}
.galleria img{width:100%; height:100%; object-fit:cover; transition:transform .6s ease, filter .3s}
.galleria button:hover img{transform:scale(1.05); filter:brightness(1.1)}
.galleria-nota{margin-top:14px; font-size:15px; color:var(--faint)}
.cantiche{display:grid; grid-template-columns:repeat(3, 1fr); gap:22px; margin-top:44px}
.cantica{border:1px solid var(--line); border-radius:6px; padding:30px 28px; background:linear-gradient(to bottom, var(--surface), var(--bg2))}
.cantica.prima{border-color:var(--gold); box-shadow:0 0 0 1px rgba(201,164,92,.2), 0 20px 60px rgba(201,164,92,.06)}
.cantica .kicker{font-size:11px}
.cantica h3{font-family:var(--caps); font-size:30px; color:var(--ink); margin:10px 0 8px}
.cantica p{color:var(--dim); font-size:17px}
.segui{display:flex; flex-wrap:wrap; gap:12px; margin-top:34px}
.segui .steam{opacity:.85; cursor:default}
.stampa{margin-top:44px; color:var(--dim); font-size:17px}
.stampa a{color:var(--gold-hi)}
footer{padding:44px 0 60px; border-top:1px solid var(--line); color:var(--faint); font-size:14px}
footer .wrap{display:flex; flex-wrap:wrap; gap:10px 28px; justify-content:space-between}
footer a{color:var(--dim)}

/* foto a tutto schermo */
#foto{border:0; padding:0; background:rgba(4,4,8,.96); width:100vw; height:100vh; max-width:none; max-height:none; color:var(--ink)}
#foto::backdrop{background:rgba(0,0,0,.85)}
#foto figure{margin:0; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:56px 70px}
#foto img{max-height:calc(100vh - 150px); width:auto; border-radius:4px}
#foto figcaption{margin-top:14px; color:var(--dim); font-style:italic}
#foto .f-btn{position:absolute; top:50%; transform:translateY(-50%); width:46px; height:46px; border-radius:50%; border:1px solid var(--line2); background:rgba(0,0,0,.4); cursor:pointer; color:var(--ink); font-size:20px}
#foto .f-prec{left:16px} #foto .f-succ{right:16px}
#foto .f-chiudi{position:absolute; top:16px; right:16px; width:42px; height:42px; border-radius:50%; border:1px solid var(--line2); background:none; cursor:pointer; color:var(--ink); font-size:20px}

@media (max-width: 900px){
  .nav-link{display:none}
  .nav{position:absolute; padding:14px 16px; gap:10px}
  .marchio{font-size:12px; letter-spacing:.14em}
  .nav-destra{gap:12px}
  .nav-destra a{font-size:11px; letter-spacing:.12em}
  .lingua{padding:3px 8px}
  .musica{padding:6px 8px}
  .musica-testo{display:none}
  .hero-testo{left:18px; right:18px; top:58px; bottom:auto; max-width:330px}
  .hero-testo .di{font-size:10px; letter-spacing:.2em}
  .hero-testo img{width:min(170px, 46vw); margin:6px 0 8px}
  .motto{font-size:15px; line-height:1.3}
  .azioni{margin-top:10px; gap:8px}
  .bottone{padding:8px 12px; font-size:10px; letter-spacing:.16em}
  .suggerimento{display:none}
  .tdc-index{top:auto; bottom:18px; right:0; left:0; transform:none; flex-direction:row; overflow-x:auto; gap:6px; padding:0 16px; scrollbar-width:none}
  .tdc-index button{flex:0 0 auto; border:1px solid var(--line2); border-radius:999px; padding:6px 12px; background:rgba(7,8,13,.7)}
  .tdc-index button .t{font-size:14px}
  #tdc-panel{top:auto; height:78%; width:100%; border-left:0; border-top:1px solid var(--line); padding:64px 24px 40px; transform:translateY(100%); background:#0a0a0f}
  .p-chiudi{top:14px; right:16px}
  #tdc-stage.scheda .tdc-index{opacity:0; pointer-events:none}
  .due, .tratti, .personaggi, .cantiche{grid-template-columns:1fr}
  .galleria{grid-template-columns:repeat(2, 1fr)}
  .galleria button, .galleria button:nth-child(-n+3){grid-column:auto}
  .galleria button:first-child{grid-column:span 2}
  .persona .ritratto{height:360px}
  #foto figure{padding:56px 12px}
}
@media (prefers-reduced-motion: reduce){ *{transition:none !important; scroll-behavior:auto !important} .musica.acceso .barre i{animation:none; height:8px} }
</style>
</head>
<body>
<header class="nav">
  <a class="marchio" href="#tdc-stage">THE DIVINE COMEDY</a>
  <nav class="nav-link" aria-label="The circles"><a href="#tdc-stage">The circles</a><a href="#gioco">The game</a><a href="#personaggi">Characters</a><a href="#galleria">Gallery</a><a href="#segui">Follow</a></nav>
  <div class="nav-destra"><button type="button" class="musica" aria-pressed="false" aria-label="Turn the music on" data-accendi="Turn the music on" data-spegni="Turn the music off" data-src="/thedivinecomedy/audio/tema.mp3"><span class="barre" aria-hidden="true"><i></i><i></i><i></i></span><span class="musica-testo">Music</span></button><a class="lingua" href="/thedivinecomedy/it/" hreflang="it" title="Italiano">IT</a><a href="/">Portfolio</a></div>
</header>

