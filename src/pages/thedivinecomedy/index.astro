<script is:inline>
(function(){
  var d = document.getElementById('foto'); if (!d || !d.showModal) return;
  var bottoni = Array.prototype.slice.call(document.querySelectorAll('.galleria button'));
  var img = d.querySelector('img'), cap = d.querySelector('figcaption'), i = 0;
  function mostra(k){ i = (k + bottoni.length) % bottoni.length; var b = bottoni[i]; img.src = b.dataset.grande; img.alt = b.dataset.alt; cap.textContent = b.dataset.alt; }
  bottoni.forEach(function(b, k){ b.addEventListener('click', function(){ mostra(k); d.showModal(); }); });
  d.querySelector('.f-prec').addEventListener('click', function(){ mostra(i - 1); });
  d.querySelector('.f-succ').addEventListener('click', function(){ mostra(i + 1); });
  d.querySelector('.f-chiudi').addEventListener('click', function(){ d.close(); });
  d.addEventListener('click', function(e){ if (e.target === d || e.target.tagName === 'FIGURE') d.close(); });
  d.addEventListener('keydown', function(e){ if (e.key === 'ArrowRight') mostra(i + 1); if (e.key === 'ArrowLeft') mostra(i - 1); });
})();
</script>
<script is:inline>(function () {
  // Musica (6/11): i browser vietano l'audio prima di un gesto, quindi parte al primo clic, tocco o tasto, sfumando; il
  // pulsante in alto la spegne e la scelta resta (tdc-musica). Il file si scarica solo in quel momento.
  var b = document.querySelector('.musica');
  if (!b) return;
  var VOLUME = 0.5, SFUMA = 1.8, CHIAVE = 'tdc-musica';
  var a = null, ctx = null, g = null, acceso = false;
  var gesti = ['mousedown', 'pointerup', 'touchend', 'keydown'];
  function leggi() { try { return localStorage.getItem(CHIAVE); } catch (e) { return null; } }
  function scrivi(v) { try { localStorage.setItem(CHIAVE, v); } catch (e) {} }
  function prepara() {
    if (a) return;
    a = new Audio(b.dataset.src);
    a.loop = true;
    // (il volume di un elemento audio su iPhone non si può cambiare: si passa da un GainNode)
    var C = window.AudioContext || window.webkitAudioContext;
    if (C) {
      ctx = new C();
      g = ctx.createGain();
      g.gain.value = 0;
      ctx.createMediaElementSource(a).connect(g);
      g.connect(ctx.destination);
    } else {
      a.volume = VOLUME;
    }
  }
  function verso(v, s) {
    if (!g) return;
    var t = ctx.currentTime;
    g.gain.cancelScheduledValues(t);
    g.gain.setValueAtTime(g.gain.value, t);
    g.gain.linearRampToValueAtTime(v, t + s);
  }
  function stato(on) {
    acceso = on;
    b.classList.toggle('acceso', on);
    b.setAttribute('aria-pressed', on ? 'true' : 'false');
    b.setAttribute('aria-label', on ? b.dataset.spegni : b.dataset.accendi);
  }
  function accendi() {
    prepara();
    if (ctx && ctx.state === 'suspended') ctx.resume();
    return a.play().then(function () { stato(true); verso(VOLUME, SFUMA); });
  }
  function spegni() {
    stato(false);
    verso(0, 0.5);
    setTimeout(function () { if (!acceso && a) a.pause(); }, 550);
  }
  function togli() { gesti.forEach(function (n) { document.removeEventListener(n, primo, true); }); }
  function primo(e) {
    if (e.target && e.target.closest && e.target.closest('.musica')) { togli(); return; }
    accendi().then(togli).catch(function () {});
  }
  b.addEventListener('click', function () {
    togli();
    if (acceso) { spegni(); scrivi('0'); } else { accendi().catch(function () {}); scrivi('1'); }
  });
  if (leggi() !== '0') gesti.forEach(function (n) { document.addEventListener(n, primo, true); });
  document.addEventListener('visibilitychange', function () {
    if (!a || !acceso) return;
    if (document.hidden) a.pause(); else a.play().catch(function () {});
  });
})();</script>
</body>
</html>
