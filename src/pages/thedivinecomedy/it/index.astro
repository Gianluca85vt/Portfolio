<script type="application/json" id="tdc-cerchi" is:inline>[{"id": "selva", "colore": "#cfe3ff", "mappa": {"r": 100, "a": 0.95, "su": 7}, "stato": "ora", "kicker": "Prologo", "nome": "La selva oscura", "nome_it": "", "canto": "Inferno I–II", "immagine": "/thedivinecomedy/img/leone.webp", "immagine_alt": "Dante si nasconde nell'erba alta mentre il leone cerca sul sentiero", "sezioni": [{"titolo": "La storia", "testo": "A metà della sua vita Dante si ritrova smarrito in una selva oscura. Prova a salire su un colle illuminato dal sole, ma tre fiere gli sbarrano la strada: la lonza, il leone e la lupa."}, {"titolo": "La guida", "testo": "Virgilio, il poeta dell'Eneide, gli appare e gli indica un'altra via: giù attraverso l'Inferno, poi su per il Purgatorio."}], "verso_it": "Nel mezzo del cammin di nostra vita\nmi ritrovai per una selva oscura,\nché la diritta via era smarrita.", "verso_en": "Midway upon the journey of our life\nI found myself within a forest dark,\nFor the straightforward pathway had been lost.", "cita": "Inferno I, 1–3", "gioco": "Giocabile oggi: il vertical slice comincia qui."}, {"id": "porta", "colore": "#ffd27a", "mappa": {"r": 90.2, "a": 1.5}, "stato": "ora", "kicker": "La porta", "nome": "La porta dell'Inferno", "nome_it": "", "canto": "Inferno III", "immagine": "/thedivinecomedy/img/porta.webp", "immagine_alt": "L'iscrizione della porta dell'Inferno sospesa nell'aria sopra un albero morto", "sezioni": [{"titolo": "Il peccato", "testo": "Appena oltre la porta aspettano gli ignavi: anime vissute senza infamia e senza lode, che non si schierarono mai."}, {"titolo": "La pena", "testo": "Corrono per sempre dietro un'insegna senza nome, punti da mosconi e da vespe. Più avanti Caronte traghetta i dannati oltre il fiume Acheronte."}], "verso_it": "Lasciate ogne speranza, voi ch’intrate.", "verso_en": "All hope abandon, ye who enter in!", "cita": "Inferno III, 9", "gioco": "La porta e la sua iscrizione sono giocabili oggi; Caronte arriva nella demo."}, {"id": "limbo", "colore": "#bcd3ff", "mappa": {"r": 79.5, "a": 2.07}, "stato": "demo", "kicker": "Cerchio I", "nome": "Limbo", "nome_it": "", "canto": "Inferno IV", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "Il peccato", "testo": "Qui non si è commesso peccato. Il Limbo accoglie chi morì senza battesimo e i virtuosi vissuti prima di Cristo, tra cui Omero, Aristotele e lo stesso Virgilio."}, {"titolo": "La pena", "testo": "Nessun tormento, solo nostalgia: vivono nel desiderio, senza speranza. I grandi spiriti abitano un nobile castello cerchiato da sette mura."}], "verso_it": "semo perduti, e sol di tanto offesi\nche sanza speme vivemo in disio.", "verso_en": "Lost are we and are only so far punished,\nThat without hope we live on in desire.", "cita": "Inferno IV, 41–42", "gioco": "Nella demo."}, {"id": "lussuria", "colore": "#c39bff", "mappa": {"r": 71, "a": 2.89}, "stato": "ora", "kicker": "Cerchio II", "nome": "Lussuria", "nome_it": "", "canto": "Inferno V", "immagine": "/thedivinecomedy/img/minosse.webp", "immagine_alt": "Minosse, metà uomo e metà serpente, incombe su Dante nell'arena", "sezioni": [{"titolo": "Il peccato", "testo": "I lussuriosi, che sottomisero la ragione al desiderio: Semiramide, Cleopatra, Elena, e Francesca con Paolo."}, {"titolo": "La pena", "testo": "Una bufera che non si ferma mai li trascina nel buio, come la passione li travolse in vita."}, {"titolo": "Custode", "testo": "Minosse, giudice dei morti, sta all'ingresso. Ascolta ogni anima e si cinge con la coda tante volte quanti sono i cerchi che deve scendere."}], "verso_it": "La bufera infernal, che mai non resta,\nmena li spirti con la sua rapina;\nvoltando e percotendo li molesta.", "verso_en": "The infernal hurricane that never rests\nHurtles the spirits onward in its rapine;\nWhirling them round, and smiting, it molests them.", "cita": "Inferno V, 31–33", "gioco": "Giocabile oggi: Minosse è il boss del vertical slice."}, {"id": "gola", "colore": "#86b7dc", "mappa": {"r": 63.2, "a": 3.71}, "stato": "gioco", "kicker": "Cerchio III", "nome": "Gola", "nome_it": "", "canto": "Inferno VI", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "Il peccato", "testo": "I golosi, che vissero per il cibo e il vino."}, {"titolo": "La pena", "testo": "Giacciono nel fango sotto una pioggia eterna, fredda e greve, mista a grandine e neve."}, {"titolo": "Custode", "testo": "Cerbero, il cane a tre teste, li graffia, li scuoia e li assorda con i suoi latrati."}], "verso_it": "Io sono al terzo cerchio, de la piova\netterna, maladetta, fredda e greve;", "verso_en": "In the third circle am I of the rain\nEternal, maledict, and cold, and heavy;", "cita": "Inferno VI, 7–8", "gioco": "Nel gioco completo, Inferno."}, {"id": "avarizia", "colore": "#ffcc55", "mappa": {"r": 56, "a": 4.53}, "stato": "gioco", "kicker": "Cerchio IV", "nome": "Avarizia", "nome_it": "", "canto": "Inferno VII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "Il peccato", "testo": "Gli avari e i prodighi: chi accumulò e chi sperperò."}, {"titolo": "La pena", "testo": "In due schiere spingono col petto grandi pesi lungo il cerchio, si scontrano e si gridano: «Perché tieni?» e «Perché burli?»"}, {"titolo": "Custode", "testo": "Pluto, il dio della ricchezza, che accoglie i viandanti con un grido incomprensibile."}], "verso_it": "«Pape Satàn, pape Satàn aleppe!»", "verso_en": "“Pape Satan, Pape Satan, Aleppe!”", "cita": "Inferno VII, 1", "gioco": "Nel gioco completo, Inferno."}, {"id": "ira", "colore": "#8fcf72", "mappa": {"r": 49, "a": 5.35, "su": 2.4}, "stato": "gioco", "kicker": "Cerchio V", "nome": "Ira e accidia", "nome_it": "", "canto": "Inferno VII–VIII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "Il peccato", "testo": "Gli iracondi, che cedettero alla rabbia, e gli accidiosi, che covarono un rancore muto."}, {"titolo": "La pena", "testo": "Nella palude fangosa dello Stige gli iracondi si colpiscono e si mordono. Gli accidiosi stanno sott'acqua, e i loro sospiri salgono in bolle."}, {"titolo": "Custode", "testo": "Flegiàs, il traghettatore che porta Dante oltre lo Stige fino alle mura della città di Dite."}], "verso_it": "Fitti nel limo dicon: “Tristi fummo\nne l’aere dolce che dal sol s’allegra,\nportando dentro accidïoso fummo:", "verso_en": "Fixed in the mire they say, ‘We sullen were\nIn the sweet air, which by the sun is gladdened,\nBearing within ourselves the sluggish reek;", "cita": "Inferno VII, 121–123", "gioco": "Nel gioco completo, Inferno."}, {"id": "eresia", "colore": "#ff7a2e", "mappa": {"r": 41.7, "a": 6.17}, "stato": "gioco", "kicker": "Cerchio VI", "nome": "Eresia", "nome_it": "", "canto": "Inferno IX–XI", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "Il peccato", "testo": "Gli eretici, che negarono che l'anima viva dopo la morte, come Epicuro e i suoi seguaci."}, {"titolo": "La pena", "testo": "Dentro le mura della città di Dite giacciono in sepolcri scoperchiati e roventi. I coperchi si chiuderanno nel giorno del Giudizio."}, {"titolo": "Custode", "testo": "Le Furie e Medusa difendono la porta di Dite, finché un messo del cielo la apre."}], "verso_it": "Vedi là Farinata che s’è dritto:\nda la cintola in sù tutto ’l vedrai.", "verso_en": "Behold there Farinata who has risen;\nFrom the waist upwards wholly shalt thou see him.", "cita": "Inferno X, 32–33", "gioco": "Nel gioco completo, Inferno."}, {"id": "violenza", "colore": "#ff3d2b", "mappa": {"r": 33.5, "a": 6.99}, "stato": "gioco", "kicker": "Cerchio VII", "nome": "Violenza", "nome_it": "", "canto": "Inferno XII–XVII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "Il peccato", "testo": "I violenti, in tre gironi: contro il prossimo, contro sé stessi e contro Dio, la natura e l'arte."}, {"titolo": "La pena", "testo": "Tiranni e omicidi bollono nel Flegetonte, un fiume di sangue sorvegliato dai centauri. I suicidi diventano alberi spinosi straziati dalle Arpie. Bestemmiatori, sodomiti e usurai bruciano su un deserto di sabbia sotto una lenta pioggia di fuoco."}, {"titolo": "Custode", "testo": "Il Minotauro."}], "verso_it": "Sovra tutto ’l sabbion, d’un cader lento,\npiovean di foco dilatate falde,\ncome di neve in alpe sanza vento.", "verso_en": "O’er all the sand-waste, with a gradual fall,\nWere raining down dilated flakes of fire,\nAs of the snow on Alp without a wind.", "cita": "Inferno XIV, 28–30", "gioco": "Nel gioco completo, Inferno."}, {"id": "frode", "colore": "#ffa04d", "mappa": {"r": 25.7, "a": 7.81}, "stato": "gioco", "kicker": "Cerchio VIII", "nome": "Frode", "nome_it": "", "canto": "Inferno XVIII–XXX", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "Il peccato", "testo": "La frode verso chi non aveva motivo di fidarsi: ruffiani e seduttori, adulatori, simoniaci, indovini, barattieri, ipocriti, ladri, consiglieri fraudolenti, seminatori di discordia e falsari."}, {"titolo": "La pena", "testo": "Dieci fossati di pietra, le Malebolge, ognuno con la sua pena: frustati dai demoni, immersi nella pece bollente, schiacciati da cappe di piombo, avvolti nelle fiamme."}, {"titolo": "Custode", "testo": "Gerione, il mostro della frode, con il volto d'uomo giusto e la coda di scorpione, porta Dante giù sulla schiena."}], "verso_it": "Considerate la vostra semenza:\nfatti non foste a viver come bruti,\nma per seguir virtute e canoscenza.", "verso_en": "Consider ye the seed from which ye sprang;\nYe were not made to live like unto brutes,\nBut for pursuit of virtue and of knowledge.", "cita": "Inferno XXVI, 118–120", "gioco": "Nel gioco completo, Inferno."}, {"id": "tradimento", "colore": "#9ee8ff", "mappa": {"r": 11.5, "a": 8.63}, "stato": "gioco", "kicker": "Cerchio IX", "nome": "Tradimento", "nome_it": "", "canto": "Inferno XXXI–XXXIV", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "Il peccato", "testo": "Il tradimento, la frode più grave, contro chi si fidava: parenti, patria, ospiti e benefattori."}, {"titolo": "La pena", "testo": "Sono imprigionati nel Cocito, un lago gelato dal vento delle ali di Lucifero, in quattro zone: Caina, Antenora, Tolomea e Giudecca. Al centro Lucifero maciulla Giuda, Bruto e Cassio."}, {"titolo": "Custode", "testo": "I giganti stanno intorno al pozzo che scende verso il ghiaccio."}], "verso_it": "E quindi uscimmo a riveder le stelle.", "verso_en": "Thence we came forth to rebehold the stars.", "cita": "Inferno XXXIV, 139", "gioco": "Nel gioco completo, Inferno. Poi il viaggio continua, su per la montagna del Purgatorio."}]</script>
