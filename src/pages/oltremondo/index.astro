<script type="application/json" id="tdc-cerchi" is:inline>[{"id": "firenze", "regno": "inferno", "colore": "#ffc27a", "mappa": {"r": 128, "a": 0.5, "su": 13.5}, "stato": "demo", "kicker": "Prologue · The hub", "nome": "Florence", "nome_it": "Firenze · La casa di Dante", "canto": "Florence, 1300", "immagine": "/oltremondo/img/torre.webp", "immagine_alt": "Dante in his red hood walks out of the door of his tower", "sezioni": [{"titolo": "The city", "testo": "Florence, 1300. The journey starts in Dante's tower house, in the study where he writes late into the night. Then the city begins to fade, street after street, until the stone turns into the damp earth of the dark wood."}, {"titolo": "The hub", "testo": "In the full game Dante's study is the refuge, the room he comes back to between one stretch of the journey and the next."}], "verso_it": "I’ fui nato e cresciuto\nsovra ’l bel fiume d’Arno a la gran villa", "verso_en": "Born was I, and grew up\nIn the great town on the fair river of Arno", "cita": "Inferno XXIII, 94–95", "gioco": "Dante's tower opens the vertical slice; Florence and the hub arrive with the demo."}, {"id": "selva", "regno": "inferno", "colore": "#cfe3ff", "mappa": {"r": 100, "a": 0.95, "su": 7}, "stato": "ora", "kicker": "Prologue", "nome": "The Dark Wood", "nome_it": "Selva oscura", "canto": "Inferno I–II", "immagine": "/oltremondo/img/leone.webp", "immagine_alt": "Dante hides in the tall grass while the lion searches the path", "sezioni": [{"titolo": "The story", "testo": "At the midpoint of his life Dante finds himself lost in a dark wood. He tries to climb a sunlit hill, but three beasts bar the way: the leopard, the lion and the she-wolf."}, {"titolo": "The guide", "testo": "Virgil, the poet of the Aeneid, appears and offers another road: down through Hell, then up through Purgatory."}], "verso_it": "Nel mezzo del cammin di nostra vita\nmi ritrovai per una selva oscura,\nché la diritta via era smarrita.", "verso_en": "Midway upon the journey of our life\nI found myself within a forest dark,\nFor the straightforward pathway had been lost.", "cita": "Inferno I, 1–3", "gioco": "Playable now: the vertical slice starts here."}, {"id": "porta", "regno": "inferno", "colore": "#ffd27a", "mappa": {"r": 90.2, "a": 1.5}, "stato": "ora", "kicker": "The Gate", "nome": "The Gate of Hell", "nome_it": "Antinferno e Acheronte", "canto": "Inferno III", "immagine": "/oltremondo/img/porta.webp", "immagine_alt": "The inscription of the gate of Hell floats in the air above a dead tree", "sezioni": [{"titolo": "The sin", "testo": "Just past the gate wait the neutral: souls who lived without infamy and without praise, and never took a side."}, {"titolo": "The punishment", "testo": "They run forever behind a blank banner, stung by wasps and hornets. Beyond them Charon ferries the damned across the river Acheron."}], "verso_it": "Lasciate ogne speranza, voi ch’intrate.", "verso_en": "All hope abandon, ye who enter in!", "cita": "Inferno III, 9", "gioco": "The gate and its inscription are playable now; Charon arrives in the demo."}, {"id": "limbo", "regno": "inferno", "colore": "#bcd3ff", "mappa": {"r": 79.5, "a": 2.07}, "stato": "demo", "kicker": "Circle I", "nome": "Limbo", "nome_it": "Limbo", "canto": "Inferno IV", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The sin", "testo": "No sin was committed here. Limbo holds those who died unbaptised and the virtuous who lived before Christ, among them Homer, Aristotle and Virgil himself."}, {"titolo": "The punishment", "testo": "No torment, only longing: they live in desire, without hope. The great spirits dwell in a noble castle ringed by seven walls."}], "verso_it": "semo perduti, e sol di tanto offesi\nche sanza speme vivemo in disio.", "verso_en": "Lost are we and are only so far punished,\nThat without hope we live on in desire.", "cita": "Inferno IV, 41–42", "gioco": "In the demo."}, {"id": "lussuria", "regno": "inferno", "colore": "#c39bff", "mappa": {"r": 71, "a": 2.89}, "stato": "ora", "kicker": "Circle II", "nome": "Lust", "nome_it": "Lussuriosi", "canto": "Inferno V", "immagine": "/oltremondo/img/minosse.webp", "immagine_alt": "Minos, half man and half serpent, his tail coiled around his body", "sezioni": [{"titolo": "The sin", "testo": "The lustful, who let desire rule their reason: Semiramis, Cleopatra, Helen, and Francesca with Paolo."}, {"titolo": "The punishment", "testo": "A storm that never rests whirls them through the dark, as passion swept them away in life."}, {"titolo": "Guardian", "testo": "Minos, judge of the dead, stands at the entrance. He hears each soul and coils his tail around himself as many times as the circles it must go down."}], "verso_it": "La bufera infernal, che mai non resta,\nmena li spirti con la sua rapina;\nvoltando e percotendo li molesta.", "verso_en": "The infernal hurricane that never rests\nHurtles the spirits onward in its rapine;\nWhirling them round, and smiting, it molests them.", "cita": "Inferno V, 31–33", "gioco": "Playable now: Minos is the boss of the vertical slice."}, {"id": "gola", "regno": "inferno", "colore": "#86b7dc", "mappa": {"r": 63.2, "a": 3.71}, "stato": "gioco", "kicker": "Circle III", "nome": "Gluttony", "nome_it": "Golosi", "canto": "Inferno VI", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The sin", "testo": "The gluttons, who lived for food and drink."}, {"titolo": "The punishment", "testo": "They lie in foul mud under an eternal rain, cold and heavy, mixed with hail and snow."}, {"titolo": "Guardian", "testo": "Cerberus, the three-headed dog, claws them, flays them and deafens them with his barking."}], "verso_it": "Io sono al terzo cerchio, de la piova\netterna, maladetta, fredda e greve;", "verso_en": "In the third circle am I of the rain\nEternal, maledict, and cold, and heavy;", "cita": "Inferno VI, 7–8", "gioco": "In the full game, Inferno."}, {"id": "avarizia", "regno": "inferno", "colore": "#ffcc55", "mappa": {"r": 56, "a": 4.53}, "stato": "gioco", "kicker": "Circle IV", "nome": "Greed", "nome_it": "Avari e prodighi", "canto": "Inferno VII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The sin", "testo": "The avaricious and the prodigal: those who hoarded and those who squandered."}, {"titolo": "The punishment", "testo": "In two crowds they roll great weights with their chests around the circle, crash into each other and shout: “Why do you hoard?” “Why do you squander?”"}, {"titolo": "Guardian", "testo": "Plutus, the god of wealth, who greets the travellers with a cry no one understands."}], "verso_it": "«Pape Satàn, pape Satàn aleppe!»", "verso_en": "“Pape Satan, Pape Satan, Aleppe!”", "cita": "Inferno VII, 1", "gioco": "In the full game, Inferno."}, {"id": "ira", "regno": "inferno", "colore": "#8fcf72", "mappa": {"r": 49, "a": 5.35, "su": 2.4}, "stato": "gioco", "kicker": "Circle V", "nome": "Wrath and Sloth", "nome_it": "Iracondi e accidiosi", "canto": "Inferno VII–VIII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The sin", "testo": "The wrathful, who gave in to rage, and the sullen, who smouldered in silent resentment."}, {"titolo": "The punishment", "testo": "In the muddy marsh of the Styx the wrathful strike and bite each other. The sullen lie beneath the water, and their sighs rise as bubbles."}, {"titolo": "Guardian", "testo": "Phlegyas, the ferryman who carries Dante across the Styx to the walls of the city of Dis."}], "verso_it": "Fitti nel limo dicon: “Tristi fummo\nne l’aere dolce che dal sol s’allegra,\nportando dentro accidïoso fummo:", "verso_en": "Fixed in the mire they say, ‘We sullen were\nIn the sweet air, which by the sun is gladdened,\nBearing within ourselves the sluggish reek;", "cita": "Inferno VII, 121–123", "gioco": "In the full game, Inferno."}, {"id": "eresia", "regno": "inferno", "colore": "#ff7a2e", "mappa": {"r": 41.7, "a": 6.17}, "stato": "gioco", "kicker": "Circle VI", "nome": "Heresy", "nome_it": "Eretici", "canto": "Inferno IX–XI", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The sin", "testo": "The heretics, who denied that the soul lives on after death, as Epicurus and his followers did."}, {"titolo": "The punishment", "testo": "Inside the walls of the city of Dis they lie in open tombs, burning. The lids will close on Judgement Day."}, {"titolo": "Guardian", "testo": "The Furies and Medusa defend the gate of Dis, until a messenger from Heaven opens it."}], "verso_it": "Vedi là Farinata che s’è dritto:\nda la cintola in sù tutto ’l vedrai.", "verso_en": "Behold there Farinata who has risen;\nFrom the waist upwards wholly shalt thou see him.", "cita": "Inferno X, 32–33", "gioco": "In the full game, Inferno."}, {"id": "violenza", "regno": "inferno", "colore": "#ff3d2b", "mappa": {"r": 33.5, "a": 6.99}, "stato": "gioco", "kicker": "Circle VII", "nome": "Violence", "nome_it": "Violenti", "canto": "Inferno XII–XVII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The sin", "testo": "The violent, in three rings: against others, against themselves, and against God, nature and art."}, {"titolo": "The punishment", "testo": "Tyrants and murderers boil in the Phlegethon, a river of blood watched by centaurs. Suicides become thorny trees torn by the Harpies. Blasphemers, sodomites and usurers burn on a desert of sand under a slow rain of fire."}, {"titolo": "Guardian", "testo": "The Minotaur."}], "verso_it": "Sovra tutto ’l sabbion, d’un cader lento,\npiovean di foco dilatate falde,\ncome di neve in alpe sanza vento.", "verso_en": "O’er all the sand-waste, with a gradual fall,\nWere raining down dilated flakes of fire,\nAs of the snow on Alp without a wind.", "cita": "Inferno XIV, 28–30", "gioco": "In the full game, Inferno."}, {"id": "frode", "regno": "inferno", "colore": "#ffa04d", "mappa": {"r": 25.7, "a": 7.81}, "stato": "gioco", "kicker": "Circle VIII", "nome": "Fraud", "nome_it": "Fraudolenti · Malebolge", "canto": "Inferno XVIII–XXX", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The sin", "testo": "Fraud against those who had no reason to trust: panderers and seducers, flatterers, simonists, soothsayers, corrupt officials, hypocrites, thieves, false counsellors, sowers of discord and falsifiers."}, {"titolo": "The punishment", "testo": "Ten stone ditches, the Malebolge, each with its own torment: whipped by demons, plunged in boiling pitch, crushed under cloaks of lead, wrapped in flames."}, {"titolo": "Guardian", "testo": "Geryon, the monster of fraud, with the face of an honest man and a scorpion's tail, carries Dante down on his back."}], "verso_it": "Considerate la vostra semenza:\nfatti non foste a viver come bruti,\nma per seguir virtute e canoscenza.", "verso_en": "Consider ye the seed from which ye sprang;\nYe were not made to live like unto brutes,\nBut for pursuit of virtue and of knowledge.", "cita": "Inferno XXVI, 118–120", "gioco": "In the full game, Inferno."}, {"id": "tradimento", "regno": "inferno", "colore": "#9ee8ff", "mappa": {"r": 11.5, "a": 8.63}, "stato": "gioco", "kicker": "Circle IX", "nome": "Treachery", "nome_it": "Traditori · Cocito", "canto": "Inferno XXXI–XXXIV", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The sin", "testo": "Treachery, the gravest fraud, against those who trusted: kin, homeland, guests and benefactors."}, {"titolo": "The punishment", "testo": "They are held in Cocytus, a lake frozen by the wind of Lucifer's wings, in four zones: Caina, Antenora, Ptolomea and Judecca. At the centre Lucifer chews Judas, Brutus and Cassius."}, {"titolo": "Guardian", "testo": "The giants stand around the well that leads down to the ice."}], "verso_it": "E quindi uscimmo a riveder le stelle.", "verso_en": "Thence we came forth to rebehold the stars.", "cita": "Inferno XXXIV, 139", "gioco": "In the full game, Inferno. Then the journey goes on, up the mountain of Purgatory."}, {"id": "antipurgatorio", "regno": "purgatorio", "colore": "#ffe2b0", "mappa": {"anello": 0, "a": 1.3}, "stato": "gioco", "kicker": "The shore", "nome": "Ante-Purgatory", "nome_it": "Antipurgatorio", "canto": "Purgatorio I–VIII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The arrival", "testo": "Dante and Virgil climb out of Hell onto a beach at the foot of a mountain, at dawn, under four stars that no one has seen since Adam and Eve. Virgil girds Dante with a reed and washes the grime of Hell from his face with dew."}, {"titolo": "The souls", "testo": "Here the late repentant wait before they may climb: the excommunicated, the lazy, those who died by violence and repented with their last breath, and the negligent princes in their valley of flowers."}, {"titolo": "Guardian", "testo": "Cato of Utica, an old man with a long beard streaked with white, keeps watch over the shore."}], "verso_it": "Per correr miglior acque alza le vele\nomai la navicella del mio ingegno,\nche lascia dietro a sé mar sì crudele;", "verso_en": "To run o’er better waters hoists its sail\nThe little vessel of my genius now,\nThat leaves behind itself a sea so cruel;", "cita": "Purgatorio I, 1–3", "gioco": "In the full game, Purgatorio."}, {"id": "porta-purgatorio", "regno": "purgatorio", "colore": "#fff3c4", "mappa": {"anello": 1, "a": 1.8}, "stato": "gioco", "kicker": "The Gate", "nome": "The Gate of Purgatory", "nome_it": "Porta del Purgatorio", "canto": "Purgatorio IX", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The way in", "testo": "Lucia carries the sleeping Dante up to the gate. Three steps lead to it: white marble, a dark cracked stone, and porphyry as red as blood."}, {"titolo": "Guardian", "testo": "An angel sits on the diamond threshold with a drawn sword. He opens with the two keys Peter gave him, one of gold and one of silver, and cuts seven P's on Dante's forehead, one for each deadly sin to be washed away on the terraces above."}], "verso_it": "Sette P ne la fronte mi descrisse\ncol punton de la spada, e «Fa che lavi,\nquando se’ dentro, queste piaghe» disse.", "verso_en": "Seven P’s upon my forehead he described\nWith the sword’s point, and, “Take heed that thou wash\nThese wounds, when thou shalt be within,” he said.", "cita": "Purgatorio IX, 112–114", "gioco": "In the full game, Purgatorio."}, {"id": "cornice-superbia", "regno": "purgatorio", "colore": "#ece4d2", "mappa": {"anello": 2, "a": 1.2}, "stato": "gioco", "kicker": "Terrace I", "nome": "Pride", "nome_it": "Superbi", "canto": "Purgatorio X–XII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The sin", "testo": "The proud, who set themselves above everyone else."}, {"titolo": "The penance", "testo": "They walk bent under great stones, like the carved figures that hold up a roof with their knees against their chests. On the wall, carvings in white marble show examples of humility, so alive they would put nature to shame."}, {"titolo": "Who you meet", "testo": "Oderisi da Gubbio, the illuminator of manuscripts, who tells Dante how quickly an artist's fame passes."}], "verso_it": "Credette Cimabue ne la pittura\ntener lo campo, e ora ha Giotto il grido,\nsì che la fama di colui è scura.", "verso_en": "In painting Cimabue thought that he\nShould hold the field, now Giotto has the cry,\nSo that the other’s fame is growing dim.", "cita": "Purgatorio XI, 94–96", "gioco": "In the full game, Purgatorio."}, {"id": "cornice-invidia", "regno": "purgatorio", "colore": "#9fb6cf", "mappa": {"anello": 3, "a": 1.95}, "stato": "gioco", "kicker": "Terrace II", "nome": "Envy", "nome_it": "Invidiosi", "canto": "Purgatorio XIII–XV", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The sin", "testo": "The envious, who were glad of other people's misfortune."}, {"titolo": "The penance", "testo": "Dressed in coarse haircloth, they sit against the rock and lean on each other like blind beggars, their eyelids sewn shut with iron wire. Voices fly past calling out examples of love for others."}, {"titolo": "Who you meet", "testo": "Sapia of Siena, who rejoiced to see her own city defeated."}], "verso_it": "Savia non fui, avvegna che Sapìa\nfossi chiamata, e fui de li altrui danni\npiù lieta assai che di ventura mia.", "verso_en": "Sapient I was not, although I Sapia\nWas called, and I was at another’s harm\nMore happy far than at my own good fortune.", "cita": "Purgatorio XIII, 109–111", "gioco": "In the full game, Purgatorio."}, {"id": "cornice-ira", "regno": "purgatorio", "colore": "#c9b8ec", "mappa": {"anello": 4, "a": 1.25}, "stato": "gioco", "kicker": "Terrace III", "nome": "Wrath", "nome_it": "Iracondi", "canto": "Purgatorio XV–XVII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The sin", "testo": "The wrathful, blinded by anger."}, {"titolo": "The penance", "testo": "They walk inside a smoke darker than any night in Hell, so bitter that Dante has to keep his eyes shut and lean on Virgil's shoulder. Inside it they pray together, with one voice, for peace."}, {"titolo": "Who you meet", "testo": "Marco Lombardo, who explains to Dante that people are free to choose, and that the world goes wrong because of those who govern it."}], "verso_it": "Buio d’inferno e di notte privata\nd’ogne pianeto, sotto pover cielo,\nquant’esser può di nuvol tenebrata,", "verso_en": "Darkness of hell, and of a night deprived\nOf every planet under a poor sky,\nAs much as may be tenebrous with cloud,", "cita": "Purgatorio XVI, 1–3", "gioco": "In the full game, Purgatorio."}, {"id": "cornice-accidia", "regno": "purgatorio", "colore": "#ffd36e", "mappa": {"anello": 5, "a": 1.9}, "stato": "gioco", "kicker": "Terrace IV", "nome": "Sloth", "nome_it": "Accidiosi", "canto": "Purgatorio XVII–XIX", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The sin", "testo": "The slothful, whose love for the good was too lukewarm."}, {"titolo": "The penance", "testo": "They run around the terrace without rest, and those in front shout examples of zeal: Mary hurrying to the hills, Caesar rushing to Spain."}, {"titolo": "Who you meet", "testo": "The abbot of San Zeno in Verona, who cannot stop running even to speak."}], "verso_it": "«Ratto, ratto, che ’l tempo non si perda\nper poco amor», gridavan li altri appresso,\n«che studio di ben far grazia rinverda».", "verso_en": "“Quick! quick! so that the time may not be lost\nBy little love!” forthwith the others cried,\n“For ardour in well-doing freshens grace!”", "cita": "Purgatorio XVIII, 103–105", "gioco": "In the full game, Purgatorio."}, {"id": "cornice-avarizia", "regno": "purgatorio", "colore": "#e9c35a", "mappa": {"anello": 6, "a": 1.3}, "stato": "gioco", "kicker": "Terrace V", "nome": "Greed", "nome_it": "Avari e prodighi", "canto": "Purgatorio XIX–XXI", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The sin", "testo": "The avaricious and the prodigal, who kept their eyes fixed on the goods of the earth."}, {"titolo": "The penance", "testo": "They lie face down on the ground, bound hand and foot, weeping."}, {"titolo": "Who you meet", "testo": "Pope Adrian V, Hugh Capet, and the poet Statius: when his penance ends the whole mountain shakes, and he climbs the rest of the way with Dante and Virgil."}], "verso_it": "«Adhaesit pavimento anima mea»\nsentia dir lor con sì alti sospiri,\nche la parola a pena s’intendea.", "verso_en": "“Adhaesit pavimento anima mea,”\nI heard them say with sighings so profound,\nThat hardly could the words be understood.", "cita": "Purgatorio XIX, 73–75", "gioco": "In the full game, Purgatorio."}, {"id": "cornice-gola", "regno": "purgatorio", "colore": "#a6e27e", "mappa": {"anello": 7, "a": 1.85}, "stato": "gioco", "kicker": "Terrace VI", "nome": "Gluttony", "nome_it": "Golosi", "canto": "Purgatorio XXII–XXIV", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The sin", "testo": "The gluttons."}, {"titolo": "The penance", "testo": "Starved and as thin as skeletons, they pass under trees heavy with fragrant fruit and sprinkled with clear water, which they can never reach."}, {"titolo": "Who you meet", "testo": "Forese Donati, Dante's friend, and the poet Bonagiunta, who gives Dante's poetry its name: the sweet new style."}], "verso_it": "Ne li occhi era ciascuna oscura e cava,\npalida ne la faccia, e tanto scema\nche da l’ossa la pelle s’informava.", "verso_en": "Each in his eyes was dark and cavernous,\nPallid in face, and so emaciate\nThat from the bones the skin did shape itself.", "cita": "Purgatorio XXIII, 22–24", "gioco": "In the full game, Purgatorio."}, {"id": "cornice-lussuria", "regno": "purgatorio", "colore": "#ff7a3a", "mappa": {"anello": 8, "a": 1.35}, "stato": "gioco", "kicker": "Terrace VII", "nome": "Lust", "nome_it": "Lussuriosi", "canto": "Purgatorio XXV–XXVII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The sin", "testo": "The lustful."}, {"titolo": "The penance", "testo": "They walk inside a wall of fire that the mountain flings out across the terrace, singing and calling out examples of chastity. Two crowds meet, kiss in haste and part."}, {"titolo": "Who you meet", "testo": "The poets Guido Guinizelli and Arnaut Daniel. To go on, Dante has to walk through the fire himself: Virgil tells him that Beatrice is on the other side."}], "verso_it": "Poi s’ascose nel foco che li affina.", "verso_en": "Then hid him in the fire that purifies them.", "cita": "Purgatorio XXVI, 148", "gioco": "In the full game, Purgatorio."}, {"id": "paradiso-terrestre", "regno": "purgatorio", "colore": "#b8ff9a", "mappa": {"anello": 9, "a": 1.6}, "stato": "gioco", "kicker": "The summit", "nome": "The Earthly Paradise", "nome_it": "Paradiso terrestre", "canto": "Purgatorio XXVIII–XXXIII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The place", "testo": "The garden of Eden lies on top of the mountain: a living forest where two rivers flow from a single spring. Lethe takes away the memory of sin, Eunoe gives back the memory of every good deed."}, {"titolo": "Who you meet", "testo": "Matelda, who sings as she gathers flowers. Then a procession of lights, and Beatrice on a chariot. Virgil vanishes: from here on Beatrice is the guide."}], "verso_it": "puro e disposto a salire a le stelle.", "verso_en": "Pure and disposed to mount unto the stars.", "cita": "Purgatorio XXXIII, 145", "gioco": "In the full game, Purgatorio."}, {"id": "luna", "regno": "paradiso", "colore": "#dfe8ff", "mappa": {"anello": 0, "a": 1.2}, "stato": "gioco", "kicker": "Heaven I", "nome": "The Moon", "nome_it": "Cielo della Luna", "canto": "Paradiso II–V", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The souls", "testo": "Those who broke a vow because others forced them to. They appear to Dante as faces so faint that he takes them for reflections."}, {"titolo": "The heaven", "testo": "All the blessed live together in the Empyrean. They come down to meet Dante in the heavens to show him how close each of them is to God."}, {"titolo": "Who speaks", "testo": "Piccarda Donati, dragged out of her convent by force, who explains that every soul in Paradise is content with its place."}], "verso_it": "E ’n la sua volontade è nostra pace:\nell’è quel mare al qual tutto si move\nciò ch’ella crïa o che natura face.", "verso_en": "And his will is our peace; this is the sea\nTo which is moving onward whatsoever\nIt doth create, and all that nature makes.", "cita": "Paradiso III, 85–87", "gioco": "In the full game, Paradiso."}, {"id": "mercurio", "regno": "paradiso", "colore": "#a9dcff", "mappa": {"anello": 1, "a": 1.95}, "stato": "gioco", "kicker": "Heaven II", "nome": "Mercury", "nome_it": "Cielo di Mercurio", "canto": "Paradiso V–VII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The souls", "testo": "Those who did good to win honour and fame."}, {"titolo": "Who speaks", "testo": "The emperor Justinian, who put Rome's laws in order. He tells the story of the imperial eagle, from Aeneas to his own day."}], "verso_it": "Cesare fui e son Iustinïano", "verso_en": "Caesar I was, and am Justinian", "cita": "Paradiso VI, 10", "gioco": "In the full game, Paradiso."}, {"id": "venere", "regno": "paradiso", "colore": "#ffb6d9", "mappa": {"anello": 2, "a": 1.3}, "stato": "gioco", "kicker": "Heaven III", "nome": "Venus", "nome_it": "Cielo di Venere", "canto": "Paradiso VIII–IX", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The souls", "testo": "The loving spirits, who in life gave in to the power of love and now shine in Venus."}, {"titolo": "Who speaks", "testo": "Charles Martel, Cunizza da Romano and the troubadour Folquet of Marseille."}], "verso_it": "Cunizza fui chiamata, e qui refulgo\nperché mi vinse il lume d’esta stella", "verso_en": "Cunizza was I called, and here I shine\nBecause the splendour of this star o’ercame me.", "cita": "Paradiso IX, 32–33", "gioco": "In the full game, Paradiso."}, {"id": "sole", "regno": "paradiso", "colore": "#ffe27a", "mappa": {"anello": 3, "a": 1.85}, "stato": "gioco", "kicker": "Heaven IV", "nome": "The Sun", "nome_it": "Cielo del Sole", "canto": "Paradiso X–XIV", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The souls", "testo": "The wise: theologians and teachers of the Church."}, {"titolo": "The heaven", "testo": "Their lights circle Dante and Beatrice in two crowns, then three, dancing and singing like the wheels of a clock."}, {"titolo": "Who speaks", "testo": "Thomas Aquinas, who praises Saint Francis, and Bonaventure, who praises Saint Dominic."}], "verso_it": "Io fui de li agni de la santa greggia\nche Domenico mena per cammino\nu’ ben s’impingua se non si vaneggia.", "verso_en": "Of the lambs was I of the holy flock\nWhich Dominic conducteth by a road\nWhere well one fattens if he strayeth not.", "cita": "Paradiso X, 94–96", "gioco": "In the full game, Paradiso."}, {"id": "marte", "regno": "paradiso", "colore": "#ff6b4a", "mappa": {"anello": 4, "a": 1.4}, "stato": "gioco", "kicker": "Heaven V", "nome": "Mars", "nome_it": "Cielo di Marte", "canto": "Paradiso XIV–XVIII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The souls", "testo": "Those who fought for the faith. Their lights form a great cross, and Christ flashes on it."}, {"titolo": "Who speaks", "testo": "Cacciaguida, Dante's great-great-grandfather, who died on crusade. He foretells Dante's exile from Florence and gives him a task: to write down everything he has seen."}], "verso_it": "Tu proverai sì come sa di sale\nlo pane altrui, e come è duro calle\nlo scendere e ’l salir per l’altrui scale.", "verso_en": "Thou shalt have proof how savoureth of salt\nThe bread of others, and how hard a road\nThe going down and up another’s stairs.", "cita": "Paradiso XVII, 58–60", "gioco": "In the full game, Paradiso."}, {"id": "giove", "regno": "paradiso", "colore": "#e6f3ff", "mappa": {"anello": 5, "a": 1.75}, "stato": "gioco", "kicker": "Heaven VI", "nome": "Jupiter", "nome_it": "Cielo di Giove", "canto": "Paradiso XVIII–XX", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The souls", "testo": "The just rulers."}, {"titolo": "The heaven", "testo": "Their lights spell out a verse of Scripture letter by letter, then gather into the shape of an eagle that speaks with one voice for all of them."}, {"titolo": "Who speaks", "testo": "The eagle itself. In its eye shine David, the emperor Trajan and the Trojan Ripheus."}], "verso_it": "«DILIGITE IUSTITIAM», primai\nfur verbo e nome di tutto ’l dipinto;\n«QUI IUDICATIS TERRAM», fur sezzai.", "verso_en": "‘Diligite justitiam,’ these were\nFirst verb and noun of all that was depicted;\n‘Qui judicatis terram’ were the last.", "cita": "Paradiso XVIII, 91–93", "gioco": "In the full game, Paradiso."}, {"id": "saturno", "regno": "paradiso", "colore": "#ffd36a", "mappa": {"anello": 6, "a": 1.45}, "stato": "gioco", "kicker": "Heaven VII", "nome": "Saturn", "nome_it": "Cielo di Saturno", "canto": "Paradiso XXI–XXII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The souls", "testo": "The contemplatives."}, {"titolo": "The heaven", "testo": "A golden ladder rises so high that Dante cannot see its top, and the lights move up and down it. Here the music of Paradise falls silent and Beatrice stops smiling: her beauty has grown too bright for Dante to bear."}, {"titolo": "Who speaks", "testo": "Peter Damian and Saint Benedict."}], "verso_it": "di color d’oro in che raggio traluce\nvid’ io uno scaleo eretto in suso\ntanto, che nol seguiva la mia luce.", "verso_en": "Coloured like gold, on which the sunshine gleams,\nA stairway I beheld to such a height\nUplifted, that mine eye pursued it not.", "cita": "Paradiso XXI, 28–30", "gioco": "In the full game, Paradiso."}, {"id": "stelle-fisse", "regno": "paradiso", "colore": "#cfdcff", "mappa": {"anello": 7, "a": 1.7}, "stato": "gioco", "kicker": "Heaven VIII", "nome": "The Fixed Stars", "nome_it": "Cielo delle Stelle fisse", "canto": "Paradiso XXII–XXVII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The heaven", "testo": "Dante enters it in Gemini, the sign he was born under, and looks back down through the seven heavens at the Earth, as small as a threshing floor."}, {"titolo": "Who speaks", "testo": "Peter, James and John examine him on faith, hope and love. Then Adam, the first soul, answers his questions."}], "verso_it": "L’aiuola che ci fa tanto feroci", "verso_en": "The threshing-floor that maketh us so proud", "cita": "Paradiso XXII, 151", "gioco": "In the full game, Paradiso."}, {"id": "primo-mobile", "regno": "paradiso", "colore": "#bff6ff", "mappa": {"anello": 8, "a": 1.55}, "stato": "gioco", "kicker": "Heaven IX", "nome": "The Primum Mobile", "nome_it": "Primo Mobile", "canto": "Paradiso XXVII–XXIX", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The heaven", "testo": "The outermost and fastest sphere, the one that sets all the others turning."}, {"titolo": "What Dante sees", "testo": "A point of light so sharp it burns the eye, with nine circles of fire spinning around it: the orders of the angels. The nearest circle spins fastest."}], "verso_it": "un punto vidi che raggiava lume\nacuto sì, che ’l viso ch’elli affoca\nchiuder conviensi per lo forte acume;", "verso_en": "A point beheld I, that was raying out\nLight so acute, the sight which it enkindles\nMust close perforce before such great acuteness.", "cita": "Paradiso XXVIII, 16–18", "gioco": "In the full game, Paradiso."}, {"id": "empireo", "regno": "paradiso", "colore": "#fff4d6", "mappa": {"anello": 9, "a": 1.57}, "stato": "gioco", "kicker": "Beyond the heavens", "nome": "The Empyrean", "nome_it": "Empireo", "canto": "Paradiso XXX–XXXIII", "immagine": "", "immagine_alt": "", "sezioni": [{"titolo": "The place", "testo": "Pure light, outside space and time. The blessed sit on the petals of an immense white rose, tier above tier as in an amphitheatre, around a lake of light."}, {"titolo": "The end of the journey", "testo": "Beatrice returns to her seat, and Saint Bernard prays to the Virgin for Dante. For an instant Dante sees God, and his will turns as one with the love that moves everything."}], "verso_it": "l’amor che move il sole e l’altre stelle.", "verso_en": "The Love which moves the sun and the other stars.", "cita": "Paradiso XXXIII, 145", "gioco": "In the full game, Paradiso."}]</script>
