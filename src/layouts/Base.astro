---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  /** absolute path from the site root, e.g. /img/video/x.jpg */
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  /** article pages get og:type=article */
  type?: 'website' | 'article';
  publishedAt?: string;
  /** schema.org payload, rendered as JSON-LD for rich results */
  jsonLd?: Record<string, unknown>;
  /** keep a utility page out of search results */
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/img/video/U9QQZWzm9Ac.jpg',
  imageWidth = 1280,
  imageHeight = 720,
  imageAlt = 'Castle Lake — real-time environment built in Unreal Engine 5',
  type = 'website',
  publishedAt,
  jsonLd,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Opt-out must run BEFORE the tag loads. ga-disable-<ID> is Google's own
         switch: set it and gtag.js sends nothing, so the flag is read from
         localStorage first and the tag is skipped entirely when it is set.

         Device-based rather than IP-based on purpose. A home connection gets a
         new IP whenever the router restarts and a phone changes IP by the hour,
         so an IP filter quietly stops working and you never find out. A flag
         stored on the device keeps holding. Set it at /no-track/. -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('gs-no-track') === '1') {
            window['ga-disable-G-D0BYF0KT6L'] = true;
            window.__gsNoTrack = true;
          }
        } catch (e) {
          /* private mode with storage blocked: fall through and measure */
        }
      })();
    </script>

    <!-- Google tag (gtag.js) -->
    <script is:inline>
      if (!window.__gsNoTrack) {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-D0BYF0KT6L';
        document.head.appendChild(s);

        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', 'G-D0BYF0KT6L');
      }
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0C0C0C" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Gianluca Scattarella — Blog"
      href="/rss.xml"
    />

    <!-- Absolute URLs: Facebook, LinkedIn and WhatsApp will not resolve a
         relative og:image, and the preview comes out blank. -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Gianluca Scattarella" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body>
    <main style="background:#0C0C0C;overflow-x:clip">
      <slot />
    </main>
  </body>
</html>
